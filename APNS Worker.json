/**
 * LHS Life — Cloudflare Worker
 *
 * Moves the Live Activity on students' Lock Screens to the next class at each
 * bell, Monday to Friday.
 *
 * ── How it works: broadcast (iOS 18, app 1.2.1 and later) ─────────────────
 * Each phone posts its day's bell times to /bells. Phones on the same schedule
 * post the same list, so the Worker keeps each DISTINCT schedule once — no
 * device ID, no push token, nothing about the phone. A cron runs every minute,
 * Mon–Fri 6 AM–5 PM Pacific. At each bell in the union of today's schedules it
 * sends ONE push to Apple's broadcast channel ("the bell at minute X just
 * rang"), to production and sandbox both, and Apple delivers it to every phone
 * listening. Each Live Activity carries its own day's schedule and works out
 * its own class, so one message serves every schedule. After the last bell one
 * "end" push dismisses them all. 40 phones or 1,400 cost the same. How many
 * phones are listening: Apple's Push Notifications Console → Overview →
 * subscriptions — this Worker never knows.
 *
 * ── Pages you can open in a browser ─────────────────────────────────────────
 * Sign-in: a browser shows a sign-in page (the password is DASHBOARD_PASSWORD)
 * and stays signed in for a year; /logout signs it out. Scripts can send it as
 * Basic auth or "X-LHS-Auth: <password>". /health needs none. The app's own
 * routes take CLIENT_SECRET instead, and the two never open each other's doors.
 *   /health   Alive? Password set? Did the latest bell's broadcast go out?
 *             Prints "broadcast: ok, last 08:55" or "broadcast: FAILED …" —
 *             point an uptime monitor at it and alert on FAILED.
 *   /status   Start here: a dashboard with charts. Today's bells and whether
 *             each went out, how long Apple took, problem reports from the
 *             past week. A dropdown picks the day
 *             (up to 3 back). /status.json?day=yyyy-MM-dd is the same data
 *             as JSON, for scripts.
 *   /test-broadcast?env=sandbox|production|both&minutes=480&end=1
 *             Sends one broadcast now and says in plain English what Apple
 *             answered. Default sandbox (Xcode builds). production reaches
 *             every student; ending them there also needs &confirm=yes.
 *
 * POST /bells and /report belong to the app. POST /register and DELETE
 * /unregister answer 410: they served the per-phone system that versions
 * 1.2.0 and earlier used, retired in October 2026 once no phone was left on it.
 *
 * In KV: bells:{day}:{hash}, one per distinct schedule, its minutes in the
 * metadata; broadcast:{day}, what was sent and Apple's answers; issue:…, a
 * reported problem (7 days). The first two expire after 3 days. Nothing
 * reads registry:devices or capacity:observed any more; if they're still
 * there, they're left over from the per-phone system and safe to delete.
 *
 * Variables: APNS_KEY_ID, APNS_TEAM_ID, APNS_BUNDLE_ID, APNS_PRIVATE_KEY (the
 * .p8 file's full contents) from Apple Developer; CLIENT_SECRET, matching
 * AppConstants.workerSecret in the app (change both together, or phones stop
 * reporting); DASHBOARD_PASSWORD, the sign-in password above, which can be
 * changed any time (until it's set, CLIENT_SECRET stands in);
 * TOKENS, the KV binding. SUBREQUEST_BUDGET and MAX_DEVICES belonged to the
 * per-phone system; if they're still set, they do nothing and can go.
 */

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Entry point
// ─────────────────────────────────────────────────────────────────────────────

export default {

  // HTTP handler — device token registration
  async fetch(request, env) {
    const url = new URL(request.url);

    // /health is the only open route — it says nothing about anyone. Every
    // other route needs the shared secret (see requireAuth).
    if (request.method === "GET" && url.pathname === "/health") {
      return handleHealth(env);
    }

    // Dashboard sign-in. A browser signs in once and keeps a cookie for a
    // year, instead of the browser's own password box, which forgets within
    // hours. See "Dashboard sign-in" below.
    if (url.pathname === "/login") {
      if (request.method === "POST") return handleLogin(request, env);
      if (request.method === "GET") return loginPage(safeNext(url.searchParams.get("next")), null, 200);
    }
    if (request.method === "GET" && url.pathname === "/logout") {
      return new Response(null, { status: 303, headers: { location: "/login", "set-cookie": `${SESSION_COOKIE}=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Strict`, "cache-control": "no-store" } });
    }

    const denied = await requireAuth(request, env, APP_ROUTES.has(`${request.method} ${url.pathname}`) ? "app" : "admin");
    if (denied) return denied;

    // The app reports its day's bell times. See handleBells.
    if (request.method === "POST" && url.pathname === "/bells") {
      return handleBells(request, env);
    }

    // Diagnostics: send ONE broadcast now and report what Apple said.
    if (request.method === "GET" && url.pathname === "/test-broadcast") {
      return handleTestBroadcast(env, url);
    }

    // Versions 1.2.0 and earlier registered each phone for pushes of its own.
    // That system was retired in October 2026, once no phone was left on it.
    // A straggler gets 410, which the old app treats as a failed registration:
    // its card keeps time on its own clock, and it files a problem report, so
    // it shows up on /status.
    if ((request.method === "POST" && url.pathname === "/register") ||
        (request.method === "DELETE" && url.pathname === "/unregister")) {
      return json({ status: "gone", message: "This version of LHS Life no longer gets Lock Screen updates. Update the app from the App Store." }, 410);
    }

    // The app tells us something is broken. See handleReport.
    if (request.method === "POST" && url.pathname === "/report") {
      return handleReport(request, env);
    }

    // The dashboard: today's bells, every send and Apple's answer, problem
    // reports. Charts and dropdowns for people; the same data
    // as JSON at /status.json?day=yyyy-MM-dd for scripts (and for the page
    // itself, when it switches days).
    if (request.method === "GET" && (url.pathname === "/status" || url.pathname === "/status.json")) {
      const today = nowInPT().iso;
      const day = url.searchParams.get("day") ?? today;
      if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return json({ error: "day must look like 2026-10-19." }, 400);
      const data = await statusData(env, day);
      return url.pathname === "/status.json" ? json(data, 200) : statusPage(data);
    }

    return new Response("LHS Life APNS Support", { status: 200 });
  },

  // Cron handler — fires every minute; see runCron
  async scheduled(event, env, ctx) {
    ctx.waitUntil(runCron(env));
  },
};

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Auth
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Two keys, two doors. /health is the only open route.
 *
 *   The app's routes (APP_ROUTES) take CLIENT_SECRET, which ships inside the
 *   app as AppConstants.workerSecret. That makes it a lock on the front door,
 *   not a vault — anyone who unpacks the app can read it — but it stops the
 *   drive-by request. Changing it breaks every phone until an app update
 *   carries the new value, so it is effectively permanent.
 *
 *   Everything a person opens — /status, its data, /test-broadcast,
 *   /test-push, /purge, /rebuild — takes DASHBOARD_PASSWORD (adminPassword),
 *   which never ships anywhere and can be changed in Cloudflare at any time.
 *   The app's secret does NOT open these pages, and the dashboard password
 *   does NOT work for the app's routes.
 *
 * Ways to present either one:
 *
 *   1. "Authorization: Bearer <secret>"      — what the iOS app sends.
 *   2. The sign-in page's cookie             — what a browser uses; see
 *      "Dashboard sign-in" below. Dashboard routes only.
 *   3. "Authorization: Basic <base64>"       — any username; the password is
 *      the key. Scripts get a WWW-Authenticate challenge when refused.
 *   4. "X-LHS-Auth: <secret>"                — for scripts and curl.
 *
 * If CLIENT_SECRET is unset the Worker refuses every authenticated route
 * rather than falling open — a misconfigured deploy should break loudly
 * instead of quietly serving the world.
 */
/** Every route but /health refuses while CLIENT_SECRET is unset — and says why. */
function missingSecret() {
  console.error("[Auth] CLIENT_SECRET is not set on this worker — refusing all authenticated routes");
  // Spelled out, because the person who hits this is an admin in a browser
  // with no logs in front of them. Fail closed, but say why and how to fix.
  return new Response(
    [
      "This worker has no CLIENT_SECRET set, so it is refusing every request.",
      "",
      "Fix it in the Cloudflare dashboard:",
      "  Workers & Pages -> this worker -> Settings -> Variables and Secrets",
      "  Add a variable named exactly CLIENT_SECRET (case-sensitive),",
      "  set its value, then click Deploy.",
      "",
      "Check it worked by loading /health — it reports 'auth: configured'.",
      "",
      "Nothing is broken for students: bell-schedule pushes keep working.",
      "Only registration and the admin pages are refused until this is set.",
    ].join("\n"),
    { status: 503, headers: { "content-type": "text/plain; charset=utf-8" } }
  );
}

/**
 * What the app itself calls. These take the app's secret (CLIENT_SECRET) and
 * nothing else; every other route is for people and takes the dashboard
 * password. The two never open each other's doors.
 */
const APP_ROUTES = new Set(["POST /bells", "POST /report", "POST /register", "DELETE /unregister"]);

/**
 * The password for everything a person opens: DASHBOARD_PASSWORD, set in the
 * Cloudflare dashboard. Until it is set, the app's secret stands in, so a
 * deploy can never lock the admin out — and the dashboard says so.
 */
function adminPassword(env) {
  return env.DASHBOARD_PASSWORD || env.CLIENT_SECRET;
}

async function requireAuth(request, env, kind) {
  if (!env.CLIENT_SECRET) return missingSecret();
  const expected = kind === "app" ? env.CLIENT_SECRET : adminPassword(env);
  const header = request.headers.get("authorization") || "";
  const scheme = header.slice(0, header.indexOf(" ")).toLowerCase();
  const value  = header.slice(header.indexOf(" ") + 1).trim();

  let presented = "";
  if (scheme === "bearer") {
    presented = value;
  } else if (scheme === "basic") {
    presented = basicPassword(value);
  } else {
    presented = (request.headers.get("x-lhs-auth") || "").trim();
  }

  if (presented && timingSafeEqual(presented, expected)) return null;

  // A signed-in browser, on a page for people. Only for looking (GET): the
  // cookie never authorizes anything the app does (POST /bells, /report,
  // /register, DELETE). And never
  // for a request another site started: SameSite=Strict already keeps the
  // browser from sending it then, and Sec-Fetch-Site says so outright, so
  // a link elsewhere can't fire /purge with an admin's cookie.
  const looking = request.method === "GET" || request.method === "HEAD";
  const fromElsewhere = request.headers.get("sec-fetch-site") === "cross-site";
  if (kind === "admin" && !presented && looking && !fromElsewhere && await validSession(request, env)) return null;

  console.log(`[Auth] rejected ${request.method} ${new URL(request.url).pathname}`);
  return unauthorized(request);
}

/**
 * The password half of a Basic credential. The username is deliberately
 * ignored: an admin typing anything at all in that field still gets in, which
 * is one less thing to explain and one less support call.
 */
function basicPassword(encoded) {
  try {
    const decoded = atob(encoded);
    const split = decoded.indexOf(":");
    return split === -1 ? "" : decoded.slice(split + 1);
  } catch {
    return "";   // not valid base64
  }
}

/**
 * What a refused request gets.
 *
 * A browser asking for a page gets the sign-in page, which sets a cookie that
 * lasts a year. Anything else (curl, scripts) gets the classic 401 with
 * WWW-Authenticate, so Basic auth and "X-LHS-Auth" keep working.
 */
function unauthorized(request) {
  const url = new URL(request.url);
  const wantsPage = request.method === "GET" && (request.headers.get("accept") || "").includes("text/html");
  if (wantsPage) {
    // The cookie is SameSite=Strict, so a browser leaves it off when /status
    // is opened from a link in another app or site — and a signed-in admin
    // would be asked to sign in again. For the dashboard only, bounce once:
    // the page reloads itself, that reload counts as same-site, and the
    // cookie comes along. Never for routes that DO something (/purge,
    // /test-broadcast…), or a link on another site could use the cookie.
    const viewOnly = url.pathname === "/status" || url.pathname === "/status.json";
    if (viewOnly && request.headers.get("sec-fetch-site") === "cross-site") {
      return new Response('<!doctype html><meta charset="utf-8"><title>LHS Life APNS Support</title><script>location.replace(location.href)</script>', {
        status: 401, headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" },
      });
    }
    return loginPage(safeNext(url.pathname + url.search), null, 401);
  }
  return new Response(
    "LHS Life APNS Support — sign in to continue. Username: anything. Password: ask ASB.",
    {
      status: 401,
      headers: {
        "WWW-Authenticate": 'Basic realm="LHS Life APNS Support", charset="UTF-8"',
        "content-type": "text/plain; charset=utf-8",
      },
    }
  );
}

// ── Dashboard sign-in ────────────────────────────────────────────────────────
//
// The sign-in page posts the password once; the Worker answers with a cookie
// that proves it, good for a year:
//
//   __Host-lhs_session = <expiry, Unix seconds>.<HMAC-SHA256 of it, keyed by the dashboard password>
//
// Nothing is stored on the server. Changing DASHBOARD_PASSWORD signs every
// browser out, because old signatures stop matching; phones are unaffected. The cookie is HttpOnly (page
// scripts can't read it), Secure, SameSite=Strict (other sites can't make the
// browser send it), and __Host- (no other workers.dev subdomain can set it).
// It only ever authorizes GET requests — see requireAuth. /logout clears it.

const SESSION_COOKIE = "__Host-lhs_session";
const SESSION_DAYS = 365;

async function sessionSignature(env, expires) {
  const key = await crypto.subtle.importKey(
    "raw", new TextEncoder().encode(adminPassword(env)), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]
  );
  const mac = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(`lhs-dashboard-session|${expires}`));
  return [...new Uint8Array(mac)].map(b => b.toString(16).padStart(2, "0")).join("");
}

async function validSession(request, env) {
  const value = readCookie(request, SESSION_COOKIE);
  if (!value) return false;
  const [exp, signature] = value.split(".");
  const expires = Number(exp);
  if (!Number.isInteger(expires) || expires <= Date.now() / 1000 || !signature) return false;
  return timingSafeEqual(signature, await sessionSignature(env, expires));
}

function readCookie(request, name) {
  for (const part of (request.headers.get("cookie") || "").split(";")) {
    const split = part.indexOf("=");
    if (split !== -1 && part.slice(0, split).trim() === name) return part.slice(split + 1).trim();
  }
  return null;
}

/** Where to go after signing in: a path on this Worker, never another site. */
function safeNext(next) {
  return typeof next === "string" && /^\/(?!\/)[^\\\s]*$/.test(next) && !next.startsWith("/login") ? next : "/status";
}

/** POST /login: the password from the sign-in page, then the cookie. */
async function handleLogin(request, env) {
  if (!env.CLIENT_SECRET) return missingSecret();
  let form = null;
  try { form = await request.formData(); } catch { /* treated as empty */ }
  const password = String(form?.get("password") ?? "");
  const next = safeNext(String(form?.get("next") ?? ""));
  if (!password || !timingSafeEqual(password, adminPassword(env))) {
    console.log("[Auth] dashboard sign-in refused");
    return loginPage(next, "That password isn't right.", 401);
  }
  const expires = Math.floor(Date.now() / 1000) + SESSION_DAYS * 86400;
  const value = `${expires}.${await sessionSignature(env, expires)}`;
  return new Response(null, {
    status: 303,
    headers: {
      location: next,
      "set-cookie": `${SESSION_COOKIE}=${value}; Path=/; Max-Age=${SESSION_DAYS * 86400}; HttpOnly; Secure; SameSite=Strict`,
      "cache-control": "no-store",
    },
  });
}

/** The sign-in page, in the dashboard's colors. */
function loginPage(next, error, status) {
  const esc = text => String(text).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const html = `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title>Sign in · LHS Life APNS Support</title>
<style>
:root{--bg:#f2f3f7;--card:#fff;--text:#0a0c10;--muted:#5b6472;--line:#e3e6ec;--accent:#2f5fc4;--gold:#a8790a;--bad:#d64545;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0a0c10;--card:#13161c;--text:#fff;--muted:#8a93a8;--line:#262b36;--accent:#3a6fd8;--gold:#f5b800;--bad:#ff6b6b;color-scheme:dark}}
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--text);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;padding:16px}
form{width:100%;max-width:360px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px}
h1{font-size:20px;margin:0}h1::after{content:"";display:block;width:40px;height:3px;border-radius:2px;background:var(--gold);margin:6px 0 14px}
label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
input{width:100%;font:inherit;padding:10px 12px;border-radius:9px;border:1px solid var(--line);background:var(--bg);color:var(--text)}
button{width:100%;margin-top:14px;font:inherit;font-weight:600;padding:10px;border:0;border-radius:9px;background:var(--accent);color:#fff;cursor:pointer}
.error{color:var(--bad);font-size:13px;margin:10px 0 0}
</style></head><body>
<form method="post" action="/login">
<h1>LHS Life APNS Support</h1>
<input type="hidden" name="next" value="${esc(next)}">
<input type="text" name="username" value="LHS Life APNS Support" autocomplete="username" hidden>
<label for="password">Password</label>
<input id="password" name="password" type="password" autocomplete="current-password" autofocus required>
${error ? `<p class="error" role="alert">${esc(error)}</p>` : ""}
<button type="submit">Sign in</button>
</form></body></html>`;
  return new Response(html, {
    status,
    headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store", "x-frame-options": "DENY", "referrer-policy": "no-referrer" },
  });
}

/** Length-independent comparison, so the check can't be timed character by character. */
function timingSafeEqual(a, b) {
  let diff = a.length ^ b.length;
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  }
  return diff === 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Broadcast
//
// iOS 18 broadcast channels: ONE push per bell to a channel, and Apple
// delivers it to every phone whose Live Activity subscribed to that channel.
// The push says only "the bell at minute X just rang"; each Live Activity
// carries its own day's schedule and works out its own class, so a single
// message serves students on different schedules.
//
// WHAT IS STORED — no device data at all:
//
//   bells:{day}:{hash}   one per DISTINCT schedule, not per phone. Every
//                        phone on the Regular schedule posts the same list,
//                        lands on the same key, and costs no write after the
//                        first. The minutes ride in KV metadata so the cron
//                        reads them all from one list() and no get()s.
//   broadcast:{day}      one record: today's union of bells (as of the last
//                        listing), which bells went out and when, and what
//                        Apple answered on each channel. Written only when
//                        something changes — about one write per bell.
//
// Both expire after 3 days on their own.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Apple's broadcast channels for this app, one per APNs environment. Not
 * secrets: a channel ID is useless without our signing key, and the app ships
 * them too (AppConstants.broadcastChannel*). App Store and TestFlight builds
 * listen on production; builds run from Xcode listen on sandbox. Every bell
 * goes to both, so both kinds of build keep working.
 *
 * Created once with Apple's channel-management API; they do not expire. If
 * one is ever deleted or recreated, update it here AND in the app.
 */
const BROADCAST_BUNDLE_ID = "com.lasalleyakima.lhslife";
const BROADCAST_CHANNELS = {
  production: "JJ+34svREfEAAGpsYJ+BOQ==",
  sandbox:    "oikr1cvOEfEAAPYv+t4beg==",
};
const BROADCAST_HOSTS = {
  production: "api.push.apple.com",
  sandbox:    "api.sandbox.push.apple.com",
};

/** Keys under bells: and broadcast: expire on their own after this. */
const BROADCAST_TTL_SECONDS = 3 * 24 * 60 * 60;

/**
 * Most distinct schedules accepted for one day. A school has a handful
 * (Regular, Late Start, Assembly, finals…); 30 is far past honest use and
 * bounds what a leaked secret could make the cron do.
 */
const MAX_SCHEDULES_PER_DAY = 30;

/** Bell times accepted from the app: 5:00 AM to 8:00 PM, at most 40 a day. */
const MIN_BELL_MINUTE = 300;
const MAX_BELL_MINUTE = 1200;
const MAX_BELLS_PER_SCHEDULE = 40;

/**
 * How late a bell may still go out. A cron run can be skipped or late; a bell
 * up to 2 minutes old is still worth sending, an older one is not — by then
 * the card has already moved on by its own clock.
 */
const BROADCAST_CATCH_UP_MINUTES = 2;

/** The cron's window (see runCron). Bells outside it are never broadcast. */
const CRON_FIRST_MINUTE = 6 * 60;
const CRON_END_MINUTE = 17 * 60;

/** How many failed "end" attempts before giving up for the day. */
const MAX_END_ATTEMPTS = 3;

// ── POST /bells ──────────────────────────────────────────────────────────────

/**
 * POST /bells — the app reports its day's bell times.
 *
 * Body: { day: "yyyy-MM-dd" (Pacific), minutes: [Int], environment? }
 * minutes are every start and end of that phone's day, as minutes since
 * Pacific midnight. environment is accepted and ignored: every bell goes to
 * both channels anyway.
 *
 * Repeats are the normal case — every phone on the Regular schedule sends
 * the same list, and a phone re-sends when its card restarts — so a schedule
 * already on file costs one KV read and no write. That is what keeps a whole
 * school inside the free 1,000 writes a day: a handful of writes, not one per
 * phone.
 */
async function handleBells(request, env) {
  let body;
  try { body = await request.json(); } catch {
    return json({ error: "Bad JSON" }, 400);
  }
  if (!body || typeof body !== "object") return json({ error: "Expected a JSON object." }, 400);
  if (!env.TOKENS) return json({ error: "KV binding 'TOKENS' is not configured." }, 500);

  const { day, minutes } = body;
  const today = nowInPT().iso;
  const tomorrow = addDaysISO(today, 1);
  if (day !== today && day !== tomorrow) {
    return json({ error: `day must be today (${today}) or tomorrow (${tomorrow}), Pacific time.` }, 400);
  }

  if (!Array.isArray(minutes) || minutes.length === 0 || minutes.length > MAX_BELLS_PER_SCHEDULE * 2) {
    return json({ error: `minutes must be a list of 1–${MAX_BELLS_PER_SCHEDULE} bell times.` }, 400);
  }
  const bells = cleanBells(minutes);
  if (!bells) {
    return json({
      error: `Every bell must be a whole number of minutes since midnight between ${MIN_BELL_MINUTE} (${clockTime(MIN_BELL_MINUTE)}) and ${MAX_BELL_MINUTE} (${clockTime(MAX_BELL_MINUTE)}).`,
    }, 400);
  }
  if (bells.length > MAX_BELLS_PER_SCHEDULE) {
    return json({ error: `At most ${MAX_BELLS_PER_SCHEDULE} distinct bell times.` }, 400);
  }

  const key = `bells:${day}:${await scheduleHash(bells)}`;

  // Already on file — by far the common case.
  if (await env.TOKENS.get(key) !== null) return json({ status: "ok" }, 200);

  // Not on file as-is. Only now is a list() worth it.
  const existing = await env.TOKENS.list({ prefix: `bells:${day}:` });
  const stored = existing.keys
    .map(k => ({ id: k.name.slice(`bells:${day}:`.length), bells: cleanBells(k.metadata?.m) }))
    .filter(s => s.bells);

  // Part of a schedule already on file — a phone that started its card
  // mid-day, or with a period turned off — is the same schedule. Its bells
  // are already broadcast, so there is nothing to write.
  if (stored.some(s => isSubset(bells, s.bells))) return json({ status: "ok" }, 200);

  // The cap counts real schedules, not the partial copies some may have.
  const distinct = mergeSchedules(stored);
  const absorbed = distinct.filter(s => isSubset(s.bells, bells)).length;
  if (distinct.length - absorbed >= MAX_SCHEDULES_PER_DAY) {
    console.error(`[Bells] REFUSED a new schedule for ${day} — already ${distinct.length} (cap ${MAX_SCHEDULES_PER_DAY})`);
    return json({
      status: "too_many_schedules",
      error: `This day already has ${distinct.length} different schedules, the most the server accepts.`,
    }, 429);
  }

  try {
    await env.TOKENS.put(key, JSON.stringify(bells), {
      expirationTtl: BROADCAST_TTL_SECONDS,
      metadata: { m: bells },
    });
  } catch (e) {
    console.error(`[Bells] KV write failed: ${e.message}`);
    return json({ error: "Could not store the schedule." }, 500);
  }

  console.log(`[Bells] New schedule for ${day}: ${bells.map(clockTime).join(" ")}`);
  return json({ status: "ok" }, 200);
}

/**
 * Whole minutes in range, deduplicated and sorted — or null if anything in
 * the list is not a valid bell. Also used on what comes back from KV.
 */
function cleanBells(list) {
  if (!Array.isArray(list) || list.length === 0) return null;
  if (!list.every(m => Number.isInteger(m) && m >= MIN_BELL_MINUTE && m <= MAX_BELL_MINUTE)) return null;
  return [...new Set(list)].sort((a, b) => a - b);
}

/**
 * Short, stable name for a schedule: the first 12 hex digits of the SHA-256
 * of its sorted minutes. The same list always gives the same key, which is
 * the whole trick behind one write per schedule rather than per phone.
 */
async function scheduleHash(bells) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(bells.join(",")));
  return [...new Uint8Array(digest)].slice(0, 6).map(b => b.toString(16).padStart(2, "0")).join("");
}

/** "2026-10-19" + 1 -> "2026-10-20". Calendar arithmetic only, no time zone. */
function addDaysISO(iso, days) {
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
}

/**
 * Today's schedules from ONE list() call — the minutes come back in the
 * metadata, so no key is read. Returns the union of all bells, sorted, and
 * the distinct schedules (see mergeSchedules).
 */
async function readSchedules(env, day) {
  const listing = await env.TOKENS.list({ prefix: `bells:${day}:` });
  const schedules = [];
  for (const entry of listing.keys) {
    const bells = cleanBells(entry.metadata?.m);
    if (bells) schedules.push({ id: entry.name.slice(`bells:${day}:`.length), bells });
  }
  const union = [...new Set(schedules.flatMap(s => s.bells))].sort((a, b) => a - b);
  return { bells: union, schedules: mergeSchedules(schedules) };
}

/** True if every bell in `part` is also in `whole`. */
function isSubset(part, whole) {
  const all = new Set(whole);
  return part.every(m => all.has(m));
}

/**
 * Schedules with any that are part of another dropped: if every bell one
 * reports is in a bigger one, they're the same schedule. App builds before
 * 1.2.1 (3) reported only the bells still ahead, so phones that started their
 * cards at different times looked like different schedules — seven on
 * Oct 22 2026, all one Even Block day. Merging changes nothing that is sent:
 * the union of bells is the same either way.
 */
function mergeSchedules(schedules) {
  const biggestFirst = [...schedules].sort((a, b) => (b.bells.length - a.bells.length) || a.id.localeCompare(b.id));
  const kept = [];
  for (const s of biggestFirst) if (!kept.some(k => isSubset(s.bells, k.bells))) kept.push(s);
  return kept.sort((a, b) => a.bells[0] - b.bells[0]);
}

// ── Cron: the broadcast cycle ────────────────────────────────────────────────

function emptyBroadcastRecord(day) {
  return {
    day,
    bells: [],        // union of today's schedules, as of the last listing
    schedules: 0,     // how many distinct schedules that union came from
    sent: [],         // bells production accepted, plus "end"
    seen: {},         // bell -> the minute the cron first learned of it
    endAttempts: 0,
    log: [],          // every attempt: { kind, bell, at, production, sandbox }
    last: {},         // Apple's latest answer per environment
  };
}

/**
 * Runs from runCron every minute, 6 AM–5 PM.
 *
 * Cost per run:
 *   1 KV read          broadcast:{day}
 *   1 KV list          today's schedules — ODD minutes only, and only until
 *                      the day's "end" has gone out: about 270 of the free
 *                      plan's 1,000 lists a day, so Cloudflare's 50% warning
 *                      stays quiet with room for dashboard views. Other
 *                      minutes use the union saved in broadcast:{day}.
 *   2 APNs pushes      only at a bell (one per channel)
 *   1 KV write         only when something changed
 *
 * At a bell: every bell m in the union with now-2 <= m <= now that has not
 * gone out yet is due. Only the LATEST due one is sent (the card needs only
 * the newest state) and all of them are marked sent. At or after the last
 * bell, "end" goes instead, dismissing every card.
 *
 * A bell counts as sent once PRODUCTION accepts it — that is the channel
 * students' phones use. If it fails, the next run retries, for as long as the
 * bell is inside the 2-minute catch-up window. Sending the same bell twice is
 * harmless: the card shows the same state.
 */
async function runBroadcastCycle(env, nowPT) {
  const day = nowPT.iso;
  const now = nowPT.hours * 60 + nowPT.minutes;
  const key = `broadcast:${day}`;

  const stored = await env.TOKENS.get(key, "json");
  const record = { ...emptyBroadcastRecord(day), ...(stored ?? {}) };
  let dirty = false;

  if (now % 2 === 1 && !record.sent.includes("end")) {
    const { bells, schedules } = await readSchedules(env, day);
    if (bells.join(",") !== record.bells.join(",") || schedules.length !== record.schedules) {
      console.log(`[Broadcast] ${day}: ${schedules.length} schedule(s), bells ${bells.map(clockTime).join(" ") || "none"}`);
      record.bells = bells;
      record.schedules = schedules.length;
      // When each bell first appeared, so /health only judges bells this
      // Worker knew about before they rang. A phone that reports at 8:48
      // brings an 8:00 bell nobody could have sent — not a failure.
      record.seen = { ...(record.seen ?? {}) };
      for (const m of bells) if (!(m in record.seen)) record.seen[m] = now;
      dirty = true;
    }
  }

  const bells = record.bells;
  const sent = new Set(record.sent);
  const lastBell = bells.length ? bells[bells.length - 1] : null;

  // "end" goes at the day's LAST bell. If some schedule runs past 5 PM the
  // cron is asleep by then, and ending at an earlier bell would dismiss that
  // schedule's cards mid-event — so no end is sent and the cards retire on
  // their own clock instead.
  const due = bells.filter(m => m <= now && m >= now - BROADCAST_CATCH_UP_MINUTES && !sent.has(m));
  const endDue = lastBell !== null && lastBell < CRON_END_MINUTE && now >= lastBell
    && !sent.has("end") && record.endAttempts < MAX_END_ATTEMPTS;

  if (endDue || due.length > 0) {
    const kind = endDue ? "end" : "update";
    const bell = endDue ? lastBell : due[due.length - 1];
    const results = await broadcastEverywhere(env, kind, bell);
    const accepted = results.production.ok;

    if (accepted) {
      for (const m of due) sent.add(m);
      if (endDue) { sent.add(lastBell); sent.add("end"); }
      record.sent = [...sent];
    }
    if (endDue) record.endAttempts += 1;

    const at = new Date().toISOString();
    record.log = [...record.log, {
      kind, bell, at,
      production: results.production.summary,
      sandbox: results.sandbox.summary,
    }].slice(-200);
    for (const environment of Object.keys(BROADCAST_CHANNELS)) {
      record.last[environment] = { ...results[environment].summary, kind, bell, at };
    }
    dirty = true;

    const verdict = Object.entries(results).map(([e, r]) => `${e} ${r.summary.status ?? "—"}${r.ok ? "" : ` ${r.summary.reason ?? ""}`}`).join(", ");
    (accepted ? console.log : console.error)(
      `[Broadcast] ${kind} ${clockTime(bell)}${due.length > 1 ? ` (covers ${due.map(clockTime).join(" ")})` : ""} — ${verdict}`
    );
  }

  if (dirty) {
    await env.TOKENS.put(key, JSON.stringify(record), { expirationTtl: BROADCAST_TTL_SECONDS });
  }
}

// ── Sending ──────────────────────────────────────────────────────────────────

/** The push itself. "end" dismisses every card on the channel at once. */
function broadcastPayload(kind, bell) {
  const now = Math.floor(Date.now() / 1000);
  if (kind === "end") {
    return {
      aps: {
        timestamp: now,
        event: "end",
        // In the past, so iOS removes the card immediately.
        "dismissal-date": now - 60,
        "content-state": { slotStartMinutes: bell, isEnded: true },
      },
    };
  }
  return {
    aps: {
      timestamp: now,
      event: "update",
      "content-state": { slotStartMinutes: bell, isEnded: false },
    },
  };
}

/**
 * Sends one broadcast to each listed environment's channel, in parallel.
 * Never throws: a key problem comes back as a failed result for each
 * environment, so it is recorded and shown on /status and /health.
 */
async function broadcastEverywhere(env, kind, bell, environments = Object.keys(BROADCAST_CHANNELS)) {
  const payload = broadcastPayload(kind, bell);
  let jwt;
  try {
    jwt = await getAPNsJWT(env);
  } catch (e) {
    const failed = { ok: false, status: null, body: "", summary: { status: null, reason: e.message } };
    return Object.fromEntries(environments.map(environment => [environment, { ...failed, environment }]));
  }
  const results = await Promise.all(environments.map(environment => sendBroadcast(env, environment, payload, jwt)));
  return Object.fromEntries(results.map(r => [r.environment, r]));
}

/** One POST to Apple's broadcast endpoint. Success is HTTP 200. */
async function sendBroadcast(env, environment, payload, jwt) {
  const channel = BROADCAST_CHANNELS[environment];
  const url = `https://${BROADCAST_HOSTS[environment]}/4/broadcasts/apps/${BROADCAST_BUNDLE_ID}`;
  try {
    const resp = await fetch(url, {
      method: "POST",
      headers: {
        "authorization":   `bearer ${jwt}`,
        "apns-push-type":  "liveactivity",
        "apns-priority":   "10",
        "apns-expiration": "0",
        "apns-channel-id": channel,
        "content-type":    "application/json",
      },
      body: JSON.stringify(payload),
    });
    const body = await resp.text();
    const reason = resp.status === 200 ? null : apnsReason(body) ?? (body.slice(0, 120) || null);
    return {
      environment,
      channel,
      ok: resp.status === 200,
      status: resp.status,
      body,
      apnsId: resp.headers.get("apns-id"),
      apnsRequestId: resp.headers.get("apns-request-id"),
      summary: { status: resp.status, reason },
    };
  } catch (e) {
    return { environment, channel, ok: false, status: null, body: "", summary: { status: null, reason: e.message } };
  }
}

/** Apple's error bodies are {"reason":"..."}; pull the reason out. */
function apnsReason(body) {
  try { return JSON.parse(body).reason ?? null; } catch { return null; }
}

/** Plain English for the broadcast failures; falls back to explainAPNs. */
function explainBroadcast(status, body) {
  if (status === 200) return "Accepted. Apple will deliver it to every phone listening on this channel.";
  if (status === null) return "Never reached Apple — see error.";
  if (body.includes("BadChannelId") || body.includes("ChannelNotRegistered") || body.includes("MissingChannelId")) {
    return "Apple does not know this channel on this host. Production channel IDs only work on api.push.apple.com and sandbox ones on the sandbox host; if that is right, the channel was deleted and must be recreated (here AND in the app).";
  }
  if (body.includes("InvalidPushType")) {
    return "Apple refused the push type. Broadcasts must be apns-push-type: liveactivity.";
  }
  if (body.includes("BadPath") || status === 404) {
    return "Wrong URL. The broadcast path is /4/broadcasts/apps/<bundle ID>.";
  }
  if (status === 429 || body.includes("TooManyRequests")) {
    return "Apple is rate-limiting this channel. One push per bell is far below the limit, so something is sending too often.";
  }
  return explainAPNs(status, body);
}

// ── GET /test-broadcast ──────────────────────────────────────────────────────

/**
 * GET /test-broadcast[?env=sandbox|production|both][&minutes=480][&end=1]
 *
 * Sends ONE broadcast now and returns Apple's verdict, in plain English, per
 * channel — the broadcast twin of /test-push. Default env is sandbox, which
 * reaches only builds run from Xcode. Default minutes is today's most recent
 * bell, which is what every card should already show, so a production test
 * at the default changes nothing a student can see.
 *
 * &end=1 sends "end" instead, which DISMISSES every card on that channel. On
 * production that is every student's Lock Screen, so it also needs
 * &confirm=yes. Nothing here is written to KV.
 */
async function handleTestBroadcast(env, url) {
  const envParam = url.searchParams.get("env") ?? "sandbox";
  const environments = envParam === "both" ? ["production", "sandbox"] : [envParam];
  if (!environments.every(e => e in BROADCAST_CHANNELS)) {
    return json({ error: "env must be sandbox, production or both." }, 400);
  }

  const end = url.searchParams.get("end") === "1";
  if (end && environments.includes("production") && url.searchParams.get("confirm") !== "yes") {
    return json({
      error: "Refusing to end every student's Live Activity without confirmation.",
      howTo: "Add &confirm=yes to this URL, or test with env=sandbox.",
    }, 400);
  }

  const nowPT = nowInPT();
  const now = nowPT.hours * 60 + nowPT.minutes;
  let bell;
  const minutesParam = url.searchParams.get("minutes");
  if (minutesParam !== null) {
    bell = Number(minutesParam);
    if (!Number.isInteger(bell) || bell < 0 || bell > 1439) {
      return json({ error: "minutes must be a whole number from 0 to 1439 (minutes since midnight)." }, 400);
    }
  } else {
    const record = env.TOKENS ? await env.TOKENS.get(`broadcast:${nowPT.iso}`, "json") : null;
    const passed = (record?.bells ?? []).filter(m => m <= now);
    bell = passed.length ? passed[passed.length - 1] : now;
  }

  // Build the signing token up front, like /test-push: a key that will not
  // even load is a different problem from Apple saying no, with its own fix.
  try {
    await getAPNsJWT(env);
  } catch (e) {
    return json({
      step: "building the APNs token",
      ok: false,
      error: e.message,
      hint: "Check APNS_PRIVATE_KEY (whole .p8 including BEGIN/END lines), APNS_KEY_ID, APNS_TEAM_ID.",
    }, 500);
  }

  const kind = end ? "end" : "update";
  const results = await broadcastEverywhere(env, kind, bell, environments);
  const attempts = environments.map(e => {
    const r = results[e];
    return {
      endpoint: e,
      host: BROADCAST_HOSTS[e],
      channel: BROADCAST_CHANNELS[e],
      status: r.status,
      ok: r.ok,
      apnsId: r.apnsId ?? null,
      apnsRequestId: r.apnsRequestId ?? null,
      response: r.status === null ? undefined : (r.body || "(empty — this is what success looks like)"),
      error: r.status === null ? r.summary.reason : undefined,
      meaning: explainBroadcast(r.status, r.body ?? ""),
    };
  });

  const allOk = attempts.every(a => a.ok);
  return json({
    sent: kind,
    slotStartMinutes: bell,
    bell: clockTime(bell),
    attempts,
    verdict: allOk
      ? "Apple accepted it. Every phone listening on that channel should change within seconds. If one does not, the problem is on that phone: an app build from before broadcast, a card started before the update, or Live Activities turned off."
      : attempts.some(a => a.ok)
        ? "Apple accepted it on some channels and refused others — see meaning for each."
        : "Apple refused every attempt — see meaning for each.",
    note: environments.includes("production")
      ? "production reaches every student on an App Store or TestFlight build."
      : "sandbox reaches only builds run from Xcode. Add &env=production or &env=both for the real thing.",
  }, 200);
}

// ── /status and /health ──────────────────────────────────────────────────────

function describeResult(summary) {
  if (!summary) return null;
  if (summary.status === 200) return "200 accepted";
  return `${summary.status ?? "no answer"}${summary.reason ? ` ${summary.reason}` : ""}`;
}

/**
 * What happened to one bell, in the words the dashboard uses:
 *
 *   sent      production accepted it (the last bell: the "end" went out)
 *   upcoming  hasn't rung yet, or rang within the catch-up window
 *   outside   before 6 AM or from 5 PM on — the cron is asleep then
 *   late      first reported after it rang, so nobody could have sent it
 *   missed    known in time and never accepted — a real failure
 *
 * Records from before "seen" was kept have no way to tell late from missed,
 * so they say late rather than raise a false alarm.
 */
function bellStatus(m, { now, sent, seen, lastBell }) {
  if (sent.has(m) || (m === lastBell && sent.has("end"))) return "sent";
  if (m < CRON_FIRST_MINUTE || m >= CRON_END_MINUTE) return "outside";
  if (now - m <= BROADCAST_CATCH_UP_MINUTES) return "upcoming";
  if (!seen || !(m in seen) || seen[m] >= m) return "late";
  return "missed";
}

/**
 * The broadcast part of /status for one day: one KV read and one list().
 * Every time is minutes since Pacific midnight, with a clock-time twin.
 */
async function readBroadcastStatus(env, day) {
  const note = "How many phones are listening comes from Apple's Push Notifications Console (Overview → subscriptions) — this Worker stores nothing about phones for broadcast.";
  if (!env.TOKENS) return { note, day, error: "KV binding 'TOKENS' is not configured." };

  const record = await env.TOKENS.get(`broadcast:${day}`, "json");
  const live = await readSchedules(env, day);
  // A past day's schedules can expire a little before its record does.
  const bells = live.bells.length ? live.bells : (record?.bells ?? []);
  const sent = new Set(record?.sent ?? []);

  const nowPT = nowInPT();
  const now = day === nowPT.iso ? nowPT.hours * 60 + nowPT.minutes
    : day < nowPT.iso ? 24 * 60 : -1;
  const context = { now, sent, seen: record?.seen ?? null, lastBell: bells.length ? bells[bells.length - 1] : null };

  const result = summary => summary ? { status: summary.status ?? null, reason: summary.reason ?? null, text: describeResult(summary) } : null;

  return {
    note,
    day,
    schedulesReported: live.schedules.length || record?.schedules || 0,
    bells: bells.map(m => ({ minute: m, time: clockTime(m), status: bellStatus(m, context) })),
    endSent: sent.has("end"),
    schedules: live.schedules.map(s => ({ id: s.id, bells: s.bells, times: s.bells.map(clockTime) })),
    sends: (record?.log ?? []).map(e => {
      // How long after the bell Apple accepted it: the cron runs once a
      // minute, so anything up to about a minute is normal.
      const t = nowInPT(new Date(e.at));
      return {
        kind: e.kind,
        bell: e.bell,
        time: clockTime(e.bell),
        at: e.at,
        delaySeconds: t.hours * 3600 + t.minutes * 60 + t.seconds - e.bell * 60,
        production: result(e.production),
        sandbox: result(e.sandbox),
      };
    }),
    lastResult: Object.fromEntries(Object.keys(BROADCAST_CHANNELS).map(environment => {
      const last = record?.last?.[environment];
      return [environment, last ? { ...result(last), kind: last.kind, bell: last.bell, time: clockTime(last.bell), at: last.at } : null];
    })),
    channels: BROADCAST_CHANNELS,
  };
}

/**
 * Days the dashboard can show: today, plus the earlier days whose
 * broadcast:{day} record hasn't expired yet (they last 3 days).
 */
async function statusDays(env, today) {
  const earlier = [1, 2, 3].map(n => addDaysISO(today, -n));
  const kept = await Promise.all(earlier.map(async d => (env.TOKENS && await env.TOKENS.get(`broadcast:${d}`) !== null) ? d : null));
  return [today, ...kept.filter(Boolean)];
}

/** Everything /status shows, for one day. Also served raw as /status.json. */
async function statusData(env, day) {
  const today = nowInPT().iso;
  let health;
  try { health = await broadcastHealth(env); } catch (e) { health = `broadcast: UNKNOWN (could not read KV: ${e.message})`; }
  return {
    generatedAt: new Date().toISOString(),
    separatePassword: Boolean(env.DASHBOARD_PASSWORD),
    today,
    day,
    days: await statusDays(env, today),
    health,
    broadcast: await readBroadcastStatus(env, day),
    issues: await readIssues(env),
  };
}

/**
 * GET /health — open, so it says nothing about anyone: whether auth is set
 * up, and whether today's most recent bell went out. An uptime monitor
 * watching for "FAILED" catches a broken key or channel within one bell.
 */
async function handleHealth(env) {
  // No secret is exposed — just whether CLIENT_SECRET exists — and it's the
  // first thing to check when the sign-in box refuses to appear.
  const configured = env.CLIENT_SECRET ? "configured" : "NOT CONFIGURED";
  let broadcast;
  try {
    broadcast = await broadcastHealth(env);
  } catch (e) {
    broadcast = `broadcast: UNKNOWN (could not read KV: ${e.message})`;
  }
  return new Response(`OK\nauth: ${configured}\n${broadcast}\n`, {
    status: 200,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

/**
 * One line: "broadcast: ok, last 08:55", "broadcast: FAILED …", or idle.
 *
 * Judges the most recent bell that is more than the catch-up window old — a
 * bell that rang 30 seconds ago has not had its cron run yet and is not a
 * failure. The last bell counts as sent when the "end" went out.
 */
async function broadcastHealth(env) {
  const nowPT = nowInPT();
  if (nowPT.dow === 0 || nowPT.dow === 6) return "broadcast: idle (weekend)";
  if (!env.TOKENS) return "broadcast: UNKNOWN (no KV binding)";

  const record = await env.TOKENS.get(`broadcast:${nowPT.iso}`, "json");
  const all = record?.bells ?? [];
  const bells = all.filter(m => m >= CRON_FIRST_MINUTE && m < CRON_END_MINUTE);
  if (bells.length === 0) return "broadcast: idle (no bells reported today)";

  const now = nowPT.hours * 60 + nowPT.minutes;
  // Only bells known before they rang (see record.seen). Records written
  // before "seen" existed judge nothing, rather than raise a false alarm.
  const seen = record.seen ?? {};
  const judged = bells.filter(m => now - m > BROADCAST_CATCH_UP_MINUTES && m in seen && seen[m] < m);
  const sent = new Set(record.sent ?? []);
  const lastBell = all[all.length - 1];
  if (judged.length === 0) {
    if (sent.has("end")) return `broadcast: ok, last ${clockTime(lastBell)} (day ended)`;
    if (now < bells[0]) return `broadcast: ok, waiting for first bell ${clockTime(bells[0])}`;
    return "broadcast: ok, nothing to judge yet (today's bells were reported after they rang)";
  }

  const bell = judged[judged.length - 1];
  const delivered = sent.has(bell) || (bell === lastBell && sent.has("end"));

  const sandbox = record.last?.sandbox;
  const sandboxNote = sandbox && sandbox.status !== 200 ? ` (sandbox: ${describeResult(sandbox)})` : "";

  if (delivered) {
    return `broadcast: ok, last ${clockTime(bell)}${bell === lastBell ? " (day ended)" : ""}${sandboxNote}`;
  }
  const production = record.last?.production;
  const why = production ? `production: ${describeResult(production)}` : "never attempted";
  return `broadcast: FAILED, ${clockTime(bell)} not delivered (${why})`;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - /status dashboard page
//
// One self-contained page: the data is embedded as JSON, the script draws it,
// and switching days fetches /status.json. Nothing is loaded from anywhere
// else — no chart library, no fonts, no CDN. The charts are plain elements
// sized with CSS, so there is nothing to update and nothing that can go
// missing.
//
// EDITING: the page is a String.raw template, so it may not contain a
// backtick or a dollar sign followed by an opening brace. Its script uses
// plain string concatenation for that reason. Text from phones (problem
// reports) is set with textContent only, never as HTML.
// ─────────────────────────────────────────────────────────────────────────────

function statusPage(data) {
  // Safe inside <script type="application/json">: no "<" can close the tag.
  const embedded = JSON.stringify(data)
    .replace(/</g, "\\u003c")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
  return new Response(STATUS_PAGE_HTML.replace("__STATUS_DATA__", () => embedded), {
    status: 200,
    headers: {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store",
      "x-frame-options": "DENY",
      "referrer-policy": "no-referrer",
    },
  });
}

