/**
 * LHS Life — Cloudflare Worker
 *
 * Moves the Live Activity on students' Lock Screens to the next class at each
 * bell, Monday to Friday.
 *
 * ── How it works: broadcast (iOS 18, app builds after 1.2) ─────────────────
 * Each phone posts its day's bell times to /bells. Phones on the same schedule
 * post the same list, so the Worker keeps each DISTINCT schedule once — no
 * device ID, no push token, nothing about the phone. A cron runs every minute,
 * Mon–Fri 6 AM–5 PM Pacific. At each bell in the union of today's schedules it
 * sends ONE push to Apple's broadcast channel ("the bell at minute X just
 * rang"), to production and sandbox both, and Apple delivers it to every phone
 * listening. Each Live Activity carries its own day's schedule and works out
 * its own class, so one message serves every schedule. After the last bell one
 * "end" push dismisses them all. 40 phones or 1,400 cost the same. How many
 * phones are listening: Apple's Push Notifications Console → Overview →
 * subscriptions — this Worker never knows.
 *
 * ── Legacy: one push per phone (v1.2 transition — remove after students update)
 * v1.2 registers a push token per phone (/register) and the cron pushes each
 * phone at its own bells. Broadcast goes first in every run and legacy gets the
 * requests left over, which on the Free plan is about 35 phones. The device ID
 * it stores is a random number the app invents; it identifies no student.
 *
 * ── Pages you can open in a browser ─────────────────────────────────────────
 * Sign-in: any username; the password is CLIENT_SECRET. /health needs none.
 *   /health   Alive? Password set? Did the latest bell's broadcast go out?
 *             Prints "broadcast: ok, last 08:55" or "broadcast: FAILED …" —
 *             point an uptime monitor at it and alert on FAILED.
 *   /status   Start here. broadcast: today's bells, how many schedules were
 *             reported, what was sent when, and Apple's last answer. issues:
 *             problems phones reported today. devices: legacy v1.2 phones.
 *             ?full=1 adds each schedule's times, the past week of problems,
 *             and every legacy phone's bell times.
 *   /test-broadcast?env=sandbox|production|both&minutes=480&end=1
 *             Sends one broadcast now and says in plain English what Apple
 *             answered. Default sandbox (Xcode builds). production reaches
 *             every student; ending them there also needs &confirm=yes.
 *   /test-push   The same for one legacy phone. ?deviceId=… picks one.
 *   /purge?confirm=yes   Dismisses and deletes every legacy registration.
 *   /rebuild  Legacy recovery only: rebuilds the device list. Rarely needed.
 *
 * POST /bells, /register, /report and DELETE /unregister belong to the app.
 *
 * In KV: bells:{day}:{hash}, one per distinct schedule, its minutes in the
 * metadata; broadcast:{day}, what was sent and Apple's answers; issue:…, a
 * reported problem (7 days). The first two expire after 3 days. Legacy:
 * registry:devices, token:{deviceId}, capacity:observed.
 *
 * Variables: APNS_KEY_ID, APNS_TEAM_ID, APNS_BUNDLE_ID, APNS_PRIVATE_KEY (the
 * .p8 file's full contents) from Apple Developer; CLIENT_SECRET, matching
 * AppConstants.workerSecret in the app and doubling as the password above;
 * TOKENS, the KV binding. Optional, legacy only: SUBREQUEST_BUDGET (default
 * 45, the Free plan's ceiling; ~900 on Paid), MAX_DEVICES (hold the cap down).
 */

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Entry point
// ─────────────────────────────────────────────────────────────────────────────

export default {

  // HTTP handler — device token registration
  async fetch(request, env) {
    const url = new URL(request.url);

    // /health is the only open route — it says nothing about anyone. Every
    // other route needs the shared secret (see requireAuth).
    if (request.method === "GET" && url.pathname === "/health") {
      return handleHealth(env);
    }

    const denied = requireAuth(request, env);
    if (denied) return denied;

    // The app reports its day's bell times. See handleBells.
    if (request.method === "POST" && url.pathname === "/bells") {
      return handleBells(request, env);
    }

    // Diagnostics: send ONE broadcast now and report what Apple said.
    if (request.method === "GET" && url.pathname === "/test-broadcast") {
      return handleTestBroadcast(env, url);
    }

    // ── Legacy routes below: v1.2 transition — remove after students update.

    if (request.method === "POST" && url.pathname === "/register") {
      return handleRegister(request, env);
    }

    if (request.method === "DELETE" && url.pathname === "/unregister") {
      return handleUnregister(request, env);
    }

    // Manual recovery: rebuilds registry:devices from the token:{id} backups.
    // Uses list() (1,000/day cap), so it is never called automatically.
    if (request.method === "GET" && url.pathname === "/rebuild") {
      const count = await rebuildRegistry(env);
      return new Response(`Rebuilt registry with ${count} device(s)`, { status: 200 });
    }

    // Wipes every registration. Requires ?confirm=yes so a stray click or a
    // prefetching browser can't empty the registry.
    //
    // Devices come back on their own — see handlePurge for exactly when,
    // because "purged and nothing returned" is the obvious next surprise.
    if (request.method === "GET" && url.pathname === "/purge") {
      return handlePurge(request, env, url);
    }

    // Diagnostics: send ONE push right now and report exactly what APNs said.
    //
    // The push cycle only fires in the two minutes after a bell, so a
    // misconfigured key is otherwise invisible until the next period change —
    // and then only in the logs. This turns "wait 45 minutes and squint at
    // the log stream" into one click, and reports the failure reason verbatim
    // (BadEnvironmentKeyInToken, InvalidProviderToken, TopicDisallowed…).
    //
    // Never removes a device: a diagnostic that deletes registrations when the
    // server is misconfigured is exactly backwards.
    if (request.method === "GET" && url.pathname === "/test-push") {
      return handleTestPush(request, env, url);
    }

    // The app tells us something is broken. See handleReport.
    if (request.method === "POST" && url.pathname === "/report") {
      return handleReport(request, env);
    }

    // Diagnostics: broadcast first, then problem reports, then the legacy
    // device list (without exposing tokens).
    if (request.method === "GET" && url.pathname === "/status") {
      const devices = await readRegistry(env);
      // ?full=1 prints the actual bell times a device is registered for,
      // rather than just how many. This is the view that answers "was the
      // 8:00 transition even stored?" when a push doesn't land — a count of
      // 15 looks identical whether the times are right or nonsense.
      const full = url.searchParams.get("full") === "1";
      const broadcast = await readBroadcastStatus(env, full);
      const { limit: capacity, source } = await effectiveLimit(env);
      const observed = await readCapacity(env);
      const issues = await readIssues(env, full);
      return new Response(JSON.stringify({
        broadcast,
        issues,
        legacy: "Everything below is v1.2 phones on one-push-per-phone (transition — remove after students update).",
        deviceCount: devices.length,
        limit: capacity,
        limitSource: source,
        slotsFree: Math.max(0, capacity - devices.length),
        atCapacity: devices.length >= capacity,
        provenCapacity: observed.proven,
        ceilingHitAt: observed.wallAt,
        devices: devices.map(d => ({
          deviceId: d.deviceId,
          environment: d.environment,
          appVersion: d.appVersion ?? null,
          osVersion: d.osVersion ?? null,
          transitions: full
            ? (d.transitions ?? []).map(clockTime)
            : (d.transitions ?? []).length,
          endMinutes: full ? clockTime(d.endMinutes) : d.endMinutes,
          updatedAt: d.updatedAt,
        })),
      }, null, 2), { status: 200, headers: { "content-type": "application/json" } });
    }

    return new Response("LHS Life Push Worker", { status: 200 });
  },

  // Cron handler — fires every minute: broadcast first, then legacy pushes
  async scheduled(event, env, ctx) {
    ctx.waitUntil(runCron(env));
  },
};

// ── Legacy capacity (v1.2 transition — remove after students update) ───────
// Everything from here to the Auth section only limits the one-push-per-phone
// path. Broadcast has no per-phone cost, so none of it applies to broadcast.

/**
 * Who to contact about raising the device limit. Sent to the app so the
 * message a student sees names a real person rather than "contact support".
 */
const CAPACITY_CONTACT = "phudson@lasalleyakima.org";

/**
 * What the Worker has learned about its own capacity, stored in KV under
 * capacity:observed as { proven, wall, wallAt, wallBudget }.
 *
 *   proven     — the most pushes a bell has ever completed without complaint.
 *                Shown on /status; evidence the budget is AT LEAST this high.
 *   wall       — how many got through on a run that had to stop early to stay
 *                inside its subrequest budget. The real ceiling, measured
 *                rather than assumed.
 *   wallBudget — the SUBREQUEST_BUDGET that wall was measured under. A wall
 *                only counts while the budget is unchanged: one recorded on the
 *                Free plan says nothing about the Paid plan, and trusting it
 *                would hold the limit at ~40 forever after an upgrade.
 *
 * HOW THE LIMIT IS CHOSEN (effectiveLimit):
 *   1. MAX_DEVICES, if set — a human holding the number down deliberately.
 *   2. Otherwise, worked out from SUBREQUEST_BUDGET: every phone costs about
 *      one subrequest per bell, plus a small fixed overhead per run, plus
 *      what the broadcast spends first (BROADCAST_RUN_COST). On the Free
 *      plan's default of 45 that is 35 phones; set SUBREQUEST_BUDGET to 900
 *      on the Paid plan and it is ~890. That one variable is all an upgrade
 *      needs.
 *   3. Capped by a wall measured under the current budget, if there is one.
 */
const CAPACITY_KEY = "capacity:observed";

/**
 * Subrequests one invocation will spend before it stops pushing. The Free
 * plan allows 50 (KV operations included); 45 leaves margin, and
 * CAPACITY_WRITE_RESERVE keeps room for the write that records the shortfall.
 * On the Workers Paid plan the allowance is 10,000 — set SUBREQUEST_BUDGET to
 * something like 900 there and the limit lifts itself from then on.
 */
const DEFAULT_SUBREQUEST_BUDGET = 45;
const CAPACITY_WRITE_RESERVE = 3;
/**
 * Subrequests a run spends before its first push: reading the device list
 * (or, every other minute, listing the registry) and the capacity record.
 * Hydrating newly registered devices can cost more on a busy morning; if it
 * does, that run stops short and records a wall, which caps the limit below.
 */
const RUN_OVERHEAD = 2;
/**
 * The most a run's broadcast spends before legacy pushing starts: read
 * broadcast:{day}, list today's schedules, two channel pushes (update OR end,
 * never both), one write. The cron broadcasts first and shares one counter,
 * so legacy pushing gets whatever is left; this keeps the legacy phone limit
 * honest about that.
 */
const BROADCAST_RUN_COST = 5;

function subrequestBudget(env) {
  return Number(env.SUBREQUEST_BUDGET ?? DEFAULT_SUBREQUEST_BUDGET);
}

/** How many phones one bell can reach on this budget: one push each. */
function budgetLimit(env) {
  return Math.max(1, subrequestBudget(env) - CAPACITY_WRITE_RESERVE - RUN_OVERHEAD - BROADCAST_RUN_COST);
}

async function readCapacity(env) {
  const raw = await env.TOKENS.get(CAPACITY_KEY, "json");
  return raw ?? { proven: 0, wall: null, wallAt: null, wallBudget: null };
}

/** The number /register enforces, and where it came from. */
async function effectiveLimit(env) {
  if (env.MAX_DEVICES) {
    return { limit: Number(env.MAX_DEVICES), source: "MAX_DEVICES" };
  }
  const budget = subrequestBudget(env);
  const fromBudget = budgetLimit(env);
  const source = env.SUBREQUEST_BUDGET ? `SUBREQUEST_BUDGET (${budget})` : `default budget (${budget})`;

  // A wall only applies to the budget it was measured under. Walls recorded
  // before wallBudget existed were all measured on the default budget.
  const observed = await readCapacity(env);
  const wallBudget = observed.wallBudget ?? DEFAULT_SUBREQUEST_BUDGET;
  if (observed.wall && wallBudget === budget && observed.wall < fromBudget) {
    return { limit: observed.wall, source: `measured at the wall (budget ${budget})` };
  }
  return { limit: fromBudget, source };
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Auth
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Shared-secret gate on every route except /health.
 *
 * This is a lock on the front door, not a vault. The secret ships inside the
 * app, so anyone who unpacks the binary can read it — what it stops is the
 * drive-by: /status used to hand out every device ID to anyone who asked, and
 * /unregister would then take any of them, which is a one-command way to kill
 * Live Activities for the whole school. It also keeps randoms from burning the
 * KV write quota through /register.
 *
 * Three ways to present the secret, all checking the same value:
 *
 *   1. "Authorization: Bearer <secret>"      — what the iOS app sends.
 *   2. "Authorization: Basic <base64>"       — what a BROWSER sends after the
 *      sign-in box. Any username works; the password is the secret. A refusal
 *      carries WWW-Authenticate, which is what makes the browser show that box
 *      in the first place, so an admin can open /status and simply log in.
 *   3. "X-LHS-Auth: <secret>"                — for scripts and curl.
 *
 * Set CLIENT_SECRET in the Cloudflare dashboard (Worker → Settings →
 * Variables). If it is unset the worker refuses every authenticated route
 * rather than falling open — a misconfigured deploy should break loudly
 * instead of quietly serving the world.
 */
function requireAuth(request, env) {
  const expected = env.CLIENT_SECRET;
  if (!expected) {
    console.error("[Auth] CLIENT_SECRET is not set on this worker — refusing all authenticated routes");
    // Spelled out, because the person who hits this is an admin in a browser
    // with no logs in front of them. Fail closed, but say why and how to fix.
    return new Response(
      [
        "This worker has no CLIENT_SECRET set, so it is refusing every request.",
        "",
        "Fix it in the Cloudflare dashboard:",
        "  Workers & Pages -> this worker -> Settings -> Variables and Secrets",
        "  Add a variable named exactly CLIENT_SECRET (case-sensitive),",
        "  set its value, then click Deploy.",
        "",
        "Check it worked by loading /health — it reports 'auth: configured'.",
        "",
        "Nothing is broken for students: bell-schedule pushes keep working.",
        "Only registration and the admin pages are refused until this is set.",
      ].join("\n"),
      { status: 503, headers: { "content-type": "text/plain; charset=utf-8" } }
    );
  }

  const header = request.headers.get("authorization") || "";
  const scheme = header.slice(0, header.indexOf(" ")).toLowerCase();
  const value  = header.slice(header.indexOf(" ") + 1).trim();

  let presented = "";
  if (scheme === "bearer") {
    presented = value;
  } else if (scheme === "basic") {
    presented = basicPassword(value);
  } else {
    presented = (request.headers.get("x-lhs-auth") || "").trim();
  }

  if (!presented || !timingSafeEqual(presented, expected)) {
    console.log(`[Auth] rejected ${request.method} ${new URL(request.url).pathname}`);
    return unauthorized();
  }
  return null;
}

/**
 * The password half of a Basic credential. The username is deliberately
 * ignored: an admin typing anything at all in that field still gets in, which
 * is one less thing to explain and one less support call.
 */
function basicPassword(encoded) {
  try {
    const decoded = atob(encoded);
    const split = decoded.indexOf(":");
    return split === -1 ? "" : decoded.slice(split + 1);
  } catch {
    return "";   // not valid base64
  }
}

/**
 * 401 with the header that makes a browser pop its own sign-in box. Without
 * WWW-Authenticate the browser just renders the body and there is nowhere to
 * type a password — which is why this exists at all.
 */
function unauthorized() {
  return new Response(
    "LHS Life Push Worker — sign in to continue. Username: anything. Password: ask ASB.",
    {
      status: 401,
      headers: {
        "WWW-Authenticate": 'Basic realm="LHS Life Push Worker", charset="UTF-8"',
        "content-type": "text/plain; charset=utf-8",
      },
    }
  );
}

/** Length-independent comparison, so the check can't be timed character by character. */
function timingSafeEqual(a, b) {
  let diff = a.length ^ b.length;
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  }
  return diff === 0;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Broadcast
//
// iOS 18 broadcast channels: ONE push per bell to a channel, and Apple
// delivers it to every phone whose Live Activity subscribed to that channel.
// The push says only "the bell at minute X just rang"; each Live Activity
// carries its own day's schedule and works out its own class, so a single
// message serves students on different schedules.
//
// WHAT IS STORED — no device data at all:
//
//   bells:{day}:{hash}   one per DISTINCT schedule, not per phone. Every
//                        phone on the Regular schedule posts the same list,
//                        lands on the same key, and costs no write after the
//                        first. The minutes ride in KV metadata so the cron
//                        reads them all from one list() and no get()s.
//   broadcast:{day}      one record: today's union of bells (as of the last
//                        listing), which bells went out and when, and what
//                        Apple answered on each channel. Written only when
//                        something changes — about one write per bell.
//
// Both expire after 3 days on their own.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Apple's broadcast channels for this app, one per APNs environment. Not
 * secrets: a channel ID is useless without our signing key, and the app ships
 * them too (AppConstants.broadcastChannel*). App Store and TestFlight builds
 * listen on production; builds run from Xcode listen on sandbox. Every bell
 * goes to both, so both kinds of build keep working.
 *
 * Created once with Apple's channel-management API; they do not expire. If
 * one is ever deleted or recreated, update it here AND in the app.
 */
const BROADCAST_BUNDLE_ID = "com.lasalleyakima.lhslife";
const BROADCAST_CHANNELS = {
  production: "JJ+34svREfEAAGpsYJ+BOQ==",
  sandbox:    "oikr1cvOEfEAAPYv+t4beg==",
};
const BROADCAST_HOSTS = {
  production: "api.push.apple.com",
  sandbox:    "api.sandbox.push.apple.com",
};

/** Keys under bells: and broadcast: expire on their own after this. */
const BROADCAST_TTL_SECONDS = 3 * 24 * 60 * 60;

/**
 * Most distinct schedules accepted for one day. A school has a handful
 * (Regular, Late Start, Assembly, finals…); 30 is far past honest use and
 * bounds what a leaked secret could make the cron do.
 */
const MAX_SCHEDULES_PER_DAY = 30;

/** Bell times accepted from the app: 5:00 AM to 8:00 PM, at most 40 a day. */
const MIN_BELL_MINUTE = 300;
const MAX_BELL_MINUTE = 1200;
const MAX_BELLS_PER_SCHEDULE = 40;

/**
 * How late a bell may still go out. A cron run can be skipped or late; a bell
 * up to 2 minutes old is still worth sending, an older one is not — by then
 * the card has already moved on by its own clock.
 */
const BROADCAST_CATCH_UP_MINUTES = 2;

/** The cron's window (see runCron). Bells outside it are never broadcast. */
const CRON_FIRST_MINUTE = 6 * 60;
const CRON_END_MINUTE = 17 * 60;

/** How many failed "end" attempts before giving up for the day. */
const MAX_END_ATTEMPTS = 3;

// ── POST /bells ──────────────────────────────────────────────────────────────

/**
 * POST /bells — the app reports its day's bell times.
 *
 * Body: { day: "yyyy-MM-dd" (Pacific), minutes: [Int], environment? }
 * minutes are every start and end of that phone's day, as minutes since
 * Pacific midnight. environment is accepted and ignored: every bell goes to
 * both channels anyway.
 *
 * Repeats are the normal case — every phone on the Regular schedule sends
 * the same list, and a phone re-sends when its card restarts — so a schedule
 * already on file costs one KV read and no write. That is what keeps a whole
 * school inside the free 1,000 writes a day: a handful of writes, not one per
 * phone.
 */
async function handleBells(request, env) {
  let body;
  try { body = await request.json(); } catch {
    return json({ error: "Bad JSON" }, 400);
  }
  if (!body || typeof body !== "object") return json({ error: "Expected a JSON object." }, 400);
  if (!env.TOKENS) return json({ error: "KV binding 'TOKENS' is not configured." }, 500);

  const { day, minutes } = body;
  const today = nowInPT().iso;
  const tomorrow = addDaysISO(today, 1);
  if (day !== today && day !== tomorrow) {
    return json({ error: `day must be today (${today}) or tomorrow (${tomorrow}), Pacific time.` }, 400);
  }

  if (!Array.isArray(minutes) || minutes.length === 0 || minutes.length > MAX_BELLS_PER_SCHEDULE * 2) {
    return json({ error: `minutes must be a list of 1–${MAX_BELLS_PER_SCHEDULE} bell times.` }, 400);
  }
  const bells = cleanBells(minutes);
  if (!bells) {
    return json({
      error: `Every bell must be a whole number of minutes since midnight between ${MIN_BELL_MINUTE} (${clockTime(MIN_BELL_MINUTE)}) and ${MAX_BELL_MINUTE} (${clockTime(MAX_BELL_MINUTE)}).`,
    }, 400);
  }
  if (bells.length > MAX_BELLS_PER_SCHEDULE) {
    return json({ error: `At most ${MAX_BELLS_PER_SCHEDULE} distinct bell times.` }, 400);
  }

  const key = `bells:${day}:${await scheduleHash(bells)}`;

  // Already on file — by far the common case.
  if (await env.TOKENS.get(key) !== null) return json({ status: "ok" }, 200);

  // A new schedule for this day. Only now is the cap worth a list().
  const existing = await env.TOKENS.list({ prefix: `bells:${day}:` });
  if (existing.keys.length >= MAX_SCHEDULES_PER_DAY) {
    console.error(`[Bells] REFUSED a new schedule for ${day} — already ${existing.keys.length} (cap ${MAX_SCHEDULES_PER_DAY})`);
    return json({
      status: "too_many_schedules",
      error: `This day already has ${existing.keys.length} different schedules, the most the server accepts.`,
    }, 429);
  }

  try {
    await env.TOKENS.put(key, JSON.stringify(bells), {
      expirationTtl: BROADCAST_TTL_SECONDS,
      metadata: { m: bells },
    });
  } catch (e) {
    console.error(`[Bells] KV write failed: ${e.message}`);
    return json({ error: "Could not store the schedule." }, 500);
  }

  console.log(`[Bells] New schedule for ${day}: ${bells.map(clockTime).join(" ")}`);
  return json({ status: "ok" }, 200);
}

/**
 * Whole minutes in range, deduplicated and sorted — or null if anything in
 * the list is not a valid bell. Also used on what comes back from KV.
 */
function cleanBells(list) {
  if (!Array.isArray(list) || list.length === 0) return null;
  if (!list.every(m => Number.isInteger(m) && m >= MIN_BELL_MINUTE && m <= MAX_BELL_MINUTE)) return null;
  return [...new Set(list)].sort((a, b) => a - b);
}

/**
 * Short, stable name for a schedule: the first 12 hex digits of the SHA-256
 * of its sorted minutes. The same list always gives the same key, which is
 * the whole trick behind one write per schedule rather than per phone.
 */
async function scheduleHash(bells) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(bells.join(",")));
  return [...new Uint8Array(digest)].slice(0, 6).map(b => b.toString(16).padStart(2, "0")).join("");
}

/** "2026-10-19" + 1 -> "2026-10-20". Calendar arithmetic only, no time zone. */
function addDaysISO(iso, days) {
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
}

/**
 * Today's schedules from ONE list() call — the minutes come back in the
 * metadata, so no key is read. Returns the union of all bells, sorted.
 */
async function readSchedules(env, day) {
  const listing = await env.TOKENS.list({ prefix: `bells:${day}:` });
  const schedules = [];
  for (const entry of listing.keys) {
    const bells = cleanBells(entry.metadata?.m);
    if (bells) schedules.push({ id: entry.name.slice(`bells:${day}:`.length), bells });
  }
  const union = [...new Set(schedules.flatMap(s => s.bells))].sort((a, b) => a - b);
  return { bells: union, schedules };
}

// ── Cron: the broadcast cycle ────────────────────────────────────────────────

function emptyBroadcastRecord(day) {
  return {
    day,
    bells: [],        // union of today's schedules, as of the last listing
    schedules: 0,     // how many distinct schedules that union came from
    sent: [],         // bells production accepted, plus "end"
    seen: {},         // bell -> the minute the cron first learned of it
    endAttempts: 0,
    log: [],          // every attempt: { kind, bell, at, production, sandbox }
    last: {},         // Apple's latest answer per environment
  };
}

/**
 * Runs inside runCron, before the legacy pushes, every minute 6 AM–5 PM.
 *
 * Cost per run, all counted against the shared subrequest budget:
 *   1 KV read          broadcast:{day}
 *   1 KV list          today's schedules — ODD minutes only (the legacy
 *                      registry lists on even ones; together they stay under
 *                      the 1,000 lists/day cap). Even minutes use the union
 *                      saved in broadcast:{day}.
 *   2 APNs pushes      only at a bell (one per channel)
 *   1 KV write         only when something changed
 * BROADCAST_RUN_COST is the worst case of these.
 *
 * At a bell: every bell m in the union with now-2 <= m <= now that has not
 * gone out yet is due. Only the LATEST due one is sent (the card needs only
 * the newest state) and all of them are marked sent. At or after the last
 * bell, "end" goes instead, dismissing every card.
 *
 * A bell counts as sent once PRODUCTION accepts it — that is the channel
 * students' phones use. If it fails, the next run retries, for as long as the
 * bell is inside the 2-minute catch-up window. Sending the same bell twice is
 * harmless: the card shows the same state.
 */
async function runBroadcastCycle(env, nowPT) {
  const day = nowPT.iso;
  const now = nowPT.hours * 60 + nowPT.minutes;
  const key = `broadcast:${day}`;

  const stored = await env.TOKENS.get(key, "json");
  const record = { ...emptyBroadcastRecord(day), ...(stored ?? {}) };
  let dirty = false;

  if (now % 2 === 1) {
    const { bells, schedules } = await readSchedules(env, day);
    if (bells.join(",") !== record.bells.join(",") || schedules.length !== record.schedules) {
      console.log(`[Broadcast] ${day}: ${schedules.length} schedule(s), bells ${bells.map(clockTime).join(" ") || "none"}`);
      record.bells = bells;
      record.schedules = schedules.length;
      // When each bell first appeared, so /health only judges bells this
      // Worker knew about before they rang. A phone that reports at 8:48
      // brings an 8:00 bell nobody could have sent — not a failure.
      record.seen = { ...(record.seen ?? {}) };
      for (const m of bells) if (!(m in record.seen)) record.seen[m] = now;
      dirty = true;
    }
  }

  const bells = record.bells;
  const sent = new Set(record.sent);
  const lastBell = bells.length ? bells[bells.length - 1] : null;

  // "end" goes at the day's LAST bell. If some schedule runs past 5 PM the
  // cron is asleep by then, and ending at an earlier bell would dismiss that
  // schedule's cards mid-event — so no end is sent and the cards retire on
  // their own clock instead.
  const due = bells.filter(m => m <= now && m >= now - BROADCAST_CATCH_UP_MINUTES && !sent.has(m));
  const endDue = lastBell !== null && lastBell < CRON_END_MINUTE && now >= lastBell
    && !sent.has("end") && record.endAttempts < MAX_END_ATTEMPTS;

  if (endDue || due.length > 0) {
    const kind = endDue ? "end" : "update";
    const bell = endDue ? lastBell : due[due.length - 1];
    const results = await broadcastEverywhere(env, kind, bell);
    const accepted = results.production.ok;

    if (accepted) {
      for (const m of due) sent.add(m);
      if (endDue) { sent.add(lastBell); sent.add("end"); }
      record.sent = [...sent];
    }
    if (endDue) record.endAttempts += 1;

    const at = new Date().toISOString();
    record.log = [...record.log, {
      kind, bell, at,
      production: results.production.summary,
      sandbox: results.sandbox.summary,
    }].slice(-200);
    for (const environment of Object.keys(BROADCAST_CHANNELS)) {
      record.last[environment] = { ...results[environment].summary, kind, bell, at };
    }
    dirty = true;

    const verdict = Object.entries(results).map(([e, r]) => `${e} ${r.summary.status ?? "—"}${r.ok ? "" : ` ${r.summary.reason ?? ""}`}`).join(", ");
    (accepted ? console.log : console.error)(
      `[Broadcast] ${kind} ${clockTime(bell)}${due.length > 1 ? ` (covers ${due.map(clockTime).join(" ")})` : ""} — ${verdict}`
    );
  }

  if (dirty) {
    await env.TOKENS.put(key, JSON.stringify(record), { expirationTtl: BROADCAST_TTL_SECONDS });
  }
}

// ── Sending ──────────────────────────────────────────────────────────────────

/** The push itself. "end" dismisses every card on the channel at once. */
function broadcastPayload(kind, bell) {
  const now = Math.floor(Date.now() / 1000);
  if (kind === "end") {
    return {
      aps: {
        timestamp: now,
        event: "end",
        // In the past, so iOS removes the card immediately.
        "dismissal-date": now - 60,
        "content-state": { slotStartMinutes: bell, isEnded: true },
      },
    };
  }
  return {
    aps: {
      timestamp: now,
      event: "update",
      "content-state": { slotStartMinutes: bell, isEnded: false },
    },
  };
}

/**
 * Sends one broadcast to each listed environment's channel, in parallel.
 * Never throws: a key problem comes back as a failed result for each
 * environment, so it is recorded and shown on /status and /health.
 */
async function broadcastEverywhere(env, kind, bell, environments = Object.keys(BROADCAST_CHANNELS)) {
  const payload = broadcastPayload(kind, bell);
  let jwt;
  try {
    jwt = await getAPNsJWT(env);
  } catch (e) {
    const failed = { ok: false, status: null, body: "", summary: { status: null, reason: e.message } };
    return Object.fromEntries(environments.map(environment => [environment, { ...failed, environment }]));
  }
  const results = await Promise.all(environments.map(environment => sendBroadcast(env, environment, payload, jwt)));
  return Object.fromEntries(results.map(r => [r.environment, r]));
}

/** One POST to Apple's broadcast endpoint. Success is HTTP 200. */
async function sendBroadcast(env, environment, payload, jwt) {
  if (env.__tally) env.__tally.n++;   // a push is a subrequest like any other
  const channel = BROADCAST_CHANNELS[environment];
  const url = `https://${BROADCAST_HOSTS[environment]}/4/broadcasts/apps/${BROADCAST_BUNDLE_ID}`;
  try {
    const resp = await fetch(url, {
      method: "POST",
      headers: {
        "authorization":   `bearer ${jwt}`,
        "apns-push-type":  "liveactivity",
        "apns-priority":   "10",
        "apns-expiration": "0",
        "apns-channel-id": channel,
        "content-type":    "application/json",
      },
      body: JSON.stringify(payload),
    });
    const body = await resp.text();
    const reason = resp.status === 200 ? null : apnsReason(body) ?? (body.slice(0, 120) || null);
    return {
      environment,
      channel,
      ok: resp.status === 200,
      status: resp.status,
      body,
      apnsId: resp.headers.get("apns-id"),
      apnsRequestId: resp.headers.get("apns-request-id"),
      summary: { status: resp.status, reason },
    };
  } catch (e) {
    return { environment, channel, ok: false, status: null, body: "", summary: { status: null, reason: e.message } };
  }
}

/** Apple's error bodies are {"reason":"..."}; pull the reason out. */
function apnsReason(body) {
  try { return JSON.parse(body).reason ?? null; } catch { return null; }
}

/** Plain English for the broadcast failures; falls back to explainAPNs. */
function explainBroadcast(status, body) {
  if (status === 200) return "Accepted. Apple will deliver it to every phone listening on this channel.";
  if (status === null) return "Never reached Apple — see error.";
  if (body.includes("BadChannelId") || body.includes("ChannelNotRegistered") || body.includes("MissingChannelId")) {
    return "Apple does not know this channel on this host. Production channel IDs only work on api.push.apple.com and sandbox ones on the sandbox host; if that is right, the channel was deleted and must be recreated (here AND in the app).";
  }
  if (body.includes("InvalidPushType")) {
    return "Apple refused the push type. Broadcasts must be apns-push-type: liveactivity.";
  }
  if (body.includes("BadPath") || status === 404) {
    return "Wrong URL. The broadcast path is /4/broadcasts/apps/<bundle ID>.";
  }
  if (status === 429 || body.includes("TooManyRequests")) {
    return "Apple is rate-limiting this channel. One push per bell is far below the limit, so something is sending too often.";
  }
  return explainAPNs(status, body);
}

// ── GET /test-broadcast ──────────────────────────────────────────────────────

/**
 * GET /test-broadcast[?env=sandbox|production|both][&minutes=480][&end=1]
 *
 * Sends ONE broadcast now and returns Apple's verdict, in plain English, per
 * channel — the broadcast twin of /test-push. Default env is sandbox, which
 * reaches only builds run from Xcode. Default minutes is today's most recent
 * bell, which is what every card should already show, so a production test
 * at the default changes nothing a student can see.
 *
 * &end=1 sends "end" instead, which DISMISSES every card on that channel. On
 * production that is every student's Lock Screen, so it also needs
 * &confirm=yes. Nothing here is written to KV.
 */
async function handleTestBroadcast(env, url) {
  const envParam = url.searchParams.get("env") ?? "sandbox";
  const environments = envParam === "both" ? ["production", "sandbox"] : [envParam];
  if (!environments.every(e => e in BROADCAST_CHANNELS)) {
    return json({ error: "env must be sandbox, production or both." }, 400);
  }

  const end = url.searchParams.get("end") === "1";
  if (end && environments.includes("production") && url.searchParams.get("confirm") !== "yes") {
    return json({
      error: "Refusing to end every student's Live Activity without confirmation.",
      howTo: "Add &confirm=yes to this URL, or test with env=sandbox.",
    }, 400);
  }

  const nowPT = nowInPT();
  const now = nowPT.hours * 60 + nowPT.minutes;
  let bell;
  const minutesParam = url.searchParams.get("minutes");
  if (minutesParam !== null) {
    bell = Number(minutesParam);
    if (!Number.isInteger(bell) || bell < 0 || bell > 1439) {
      return json({ error: "minutes must be a whole number from 0 to 1439 (minutes since midnight)." }, 400);
    }
  } else {
    const record = env.TOKENS ? await env.TOKENS.get(`broadcast:${nowPT.iso}`, "json") : null;
    const passed = (record?.bells ?? []).filter(m => m <= now);
    bell = passed.length ? passed[passed.length - 1] : now;
  }

  // Build the signing token up front, like /test-push: a key that will not
  // even load is a different problem from Apple saying no, with its own fix.
  try {
    await getAPNsJWT(env);
  } catch (e) {
    return json({
      step: "building the APNs token",
      ok: false,
      error: e.message,
      hint: "Check APNS_PRIVATE_KEY (whole .p8 including BEGIN/END lines), APNS_KEY_ID, APNS_TEAM_ID.",
    }, 500);
  }

  const kind = end ? "end" : "update";
  const results = await broadcastEverywhere(env, kind, bell, environments);
  const attempts = environments.map(e => {
    const r = results[e];
    return {
      endpoint: e,
      host: BROADCAST_HOSTS[e],
      channel: BROADCAST_CHANNELS[e],
      status: r.status,
      ok: r.ok,
      apnsId: r.apnsId ?? null,
      apnsRequestId: r.apnsRequestId ?? null,
      response: r.status === null ? undefined : (r.body || "(empty — this is what success looks like)"),
      error: r.status === null ? r.summary.reason : undefined,
      meaning: explainBroadcast(r.status, r.body ?? ""),
    };
  });

  const allOk = attempts.every(a => a.ok);
  return json({
    sent: kind,
    slotStartMinutes: bell,
    bell: clockTime(bell),
    attempts,
    verdict: allOk
      ? "Apple accepted it. Every phone listening on that channel should change within seconds. If one does not, the problem is on that phone: an app build from before broadcast, a card started before the update, or Live Activities turned off."
      : attempts.some(a => a.ok)
        ? "Apple accepted it on some channels and refused others — see meaning for each."
        : "Apple refused every attempt — see meaning for each.",
    note: environments.includes("production")
      ? "production reaches every student on an App Store or TestFlight build."
      : "sandbox reaches only builds run from Xcode. Add &env=production or &env=both for the real thing.",
  }, 200);
}

// ── /status and /health ──────────────────────────────────────────────────────

function describeResult(summary) {
  if (!summary) return null;
  if (summary.status === 200) return "200 accepted";
  return `${summary.status ?? "no answer"}${summary.reason ? ` ${summary.reason}` : ""}`;
}

/** The broadcast section of /status. One KV read and one list(). */
async function readBroadcastStatus(env, full) {
  const day = nowInPT().iso;
  const note = "Per-phone counts now come from Apple's Push Notifications Console (Overview → subscriptions) — this Worker stores nothing about phones for broadcast.";
  if (!env.TOKENS) return { note, error: "KV binding 'TOKENS' is not configured." };

  const record = await env.TOKENS.get(`broadcast:${day}`, "json");
  const live = await readSchedules(env, day);
  const sent = new Set(record?.sent ?? []);

  return {
    note,
    today: day,
    schedulesReportedToday: live.schedules.length,
    bellsToday: live.bells.map(clockTime),
    bellsSent: live.bells.filter(m => sent.has(m)).map(clockTime),
    endSent: sent.has("end"),
    sends: (record?.log ?? []).map(e => ({
      kind: e.kind,
      bell: clockTime(e.bell),
      at: e.at,
      production: describeResult(e.production),
      sandbox: describeResult(e.sandbox),
    })),
    lastResult: {
      production: record?.last?.production
        ? { result: describeResult(record.last.production), kind: record.last.production.kind, bell: clockTime(record.last.production.bell), at: record.last.production.at }
        : null,
      sandbox: record?.last?.sandbox
        ? { result: describeResult(record.last.sandbox), kind: record.last.sandbox.kind, bell: clockTime(record.last.sandbox.bell), at: record.last.sandbox.at }
        : null,
    },
    channels: BROADCAST_CHANNELS,
    ...(full ? { schedules: live.schedules.map(s => ({ id: s.id, bells: s.bells.map(clockTime) })) } : {}),
  };
}

/**
 * GET /health — open, so it says nothing about anyone: whether auth is set
 * up, and whether today's most recent bell went out. An uptime monitor
 * watching for "FAILED" catches a broken key or channel within one bell.
 */
async function handleHealth(env) {
  // No secret is exposed — just whether CLIENT_SECRET exists — and it's the
  // first thing to check when the sign-in box refuses to appear.
  const configured = env.CLIENT_SECRET ? "configured" : "NOT CONFIGURED";
  let broadcast;
  try {
    broadcast = await broadcastHealth(env);
  } catch (e) {
    broadcast = `broadcast: UNKNOWN (could not read KV: ${e.message})`;
  }
  return new Response(`OK\nauth: ${configured}\n${broadcast}\n`, {
    status: 200,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

/**
 * One line: "broadcast: ok, last 08:55", "broadcast: FAILED …", or idle.
 *
 * Judges the most recent bell that is more than the catch-up window old — a
 * bell that rang 30 seconds ago has not had its cron run yet and is not a
 * failure. The last bell counts as sent when the "end" went out.
 */
async function broadcastHealth(env) {
  const nowPT = nowInPT();
  if (nowPT.dow === 0 || nowPT.dow === 6) return "broadcast: idle (weekend)";
  if (!env.TOKENS) return "broadcast: UNKNOWN (no KV binding)";

  const record = await env.TOKENS.get(`broadcast:${nowPT.iso}`, "json");
  const all = record?.bells ?? [];
  const bells = all.filter(m => m >= CRON_FIRST_MINUTE && m < CRON_END_MINUTE);
  if (bells.length === 0) return "broadcast: idle (no bells reported today)";

  const now = nowPT.hours * 60 + nowPT.minutes;
  // Only bells known before they rang (see record.seen). Records written
  // before "seen" existed judge nothing, rather than raise a false alarm.
  const seen = record.seen ?? {};
  const judged = bells.filter(m => now - m > BROADCAST_CATCH_UP_MINUTES && m in seen && seen[m] < m);
  if (judged.length === 0) return `broadcast: ok, waiting for first bell ${clockTime(bells[0])}`;

  const bell = judged[judged.length - 1];
  const sent = new Set(record.sent ?? []);
  const lastBell = all[all.length - 1];
  const delivered = sent.has(bell) || (bell === lastBell && sent.has("end"));

  const sandbox = record.last?.sandbox;
  const sandboxNote = sandbox && sandbox.status !== 200 ? ` (sandbox: ${describeResult(sandbox)})` : "";

  if (delivered) {
    return `broadcast: ok, last ${clockTime(bell)}${bell === lastBell ? " (day ended)" : ""}${sandboxNote}`;
  }
  const production = record.last?.production;
  const why = production ? `production: ${describeResult(production)}` : "never attempted";
  return `broadcast: FAILED, ${clockTime(bell)} not delivered (${why})`;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Token registration (legacy: v1.2 transition — remove after students update)
// ─────────────────────────────────────────────────────────────────────────────

async function handleRegister(request, env) {
  let body;
  try { body = await request.json(); } catch {
    return new Response("Bad JSON", { status: 400 });
  }

  const { deviceId, pushToken, environment, transitions, endMinutes, appVersion, osVersion } = body;
  if (!deviceId || !pushToken) {
    return new Response("Missing deviceId or pushToken", { status: 400 });
  }

  // Guard against missing KV binding — the most common cause of opaque 500s.
  if (!env.TOKENS) {
    const msg = "KV binding 'TOKENS' is not configured on this worker. Check Cloudflare dashboard → Workers → Settings → Variables → KV Namespace Bindings.";
    console.error(`[Register] ${msg}`);
    return new Response(msg, { status: 500 });
  }

  // Capacity gate.
  //
  // Without this the overflow is silent AND unfair: the push loop runs out of
  // subrequests partway through, and because the device list comes back in a
  // stable order it is the same students at the end of that list who lose
  // their bell updates every single day, with nothing on screen to say why.
  //
  // Refusing the registration outright is worse for one student and better for
  // everyone: the app can tell them plainly that the server is full, instead
  // of leaving a Live Activity on their Lock Screen that silently freezes at
  // first period. Devices already registered are always readmitted, so a
  // student who had it yesterday does not lose their place to a newcomer.
  const existing = await env.TOKENS.get(`token:${deviceId}`, "json");
  if (!existing) {
    const { limit, source } = await effectiveLimit(env);
    const registered = await readRegistry(env);
    if (registered.length >= limit) {
      console.log(`[Register] REFUSED ${deviceId} — at capacity (${registered.length}/${limit}, ${source})`);
      // 507, not 200.
      //
      // Builds released before this feature existed treat ANY 200 as "you are
      // registered" and cache that for the rest of the day, so a 200 here
      // would make an older app stop asking — even if a slot frees up an hour
      // later. A non-2xx lands in their existing failure branch, which caches
      // nothing and retries on the next launch. They still cannot show the
      // explanation (that needs the app update), but they recover on their own
      // the moment there is room.
      return json({
        status: "over_capacity",
        limit,
        registered: registered.length,
        contact: CAPACITY_CONTACT,
        message: "This school's Live Activity server is full.",
      }, 507);
    }
  }

  const record = {
    deviceId,
    pushToken,
    environment: environment ?? "production",
    transitions: transitions ?? null,
    endMinutes:  endMinutes  ?? null,
    // Build identity — app build and iOS version only, no hardware model.
    // Optional: older clients don't send these.
    appVersion: appVersion ?? null,
    osVersion:  osVersion  ?? null,
    updatedAt: new Date().toISOString(),
  };

  try {
    // The device writes ONLY its own key. No read-modify-write of the shared
    // registry blob here — that was the race. The cron picks this up within
    // two minutes via reconcileRegistry().
    //
    // The updatedAt stamp is duplicated into KV metadata so reconciliation
    // can detect a changed record straight from list(), without spending a
    // read on every device to find the one that moved.
    await env.TOKENS.put(`token:${deviceId}`, JSON.stringify(record), {
      metadata: { u: record.updatedAt },
    });
  } catch (e) {
    const msg = `KV write failed: ${e.message}`;
    console.error(`[Register] ${msg}`);
    return new Response(msg, { status: 500 });
  }

  console.log(`[Register] Device ${deviceId} registered (${environment ?? "production"}) — ${(transitions ?? []).length} transitions, build ${appVersion ?? "?"} on iOS ${osVersion ?? "?"}, live within 2min`);
  return json({ status: "registered" }, 200);
}

async function handleUnregister(request, env) {
  let body;
  try { body = await request.json(); } catch {
    return new Response("Bad JSON", { status: 400 });
  }

  const { deviceId } = body;
  if (!deviceId) return new Response("Missing deviceId", { status: 400 });

  await removeDevice(deviceId, env);
  console.log(`[Unregister] Device ${deviceId} removed`);
  return new Response("OK", { status: 200 });
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Purge (legacy: v1.2 transition — remove after students update)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * GET /purge?confirm=yes — dismiss every Live Activity, then delete every
 * registration.
 *
 * The end push matters as much as the delete. Without it a purged phone keeps
 * a Live Activity on its Lock Screen that nothing will ever update again —
 * frozen on whatever period was current when the purge ran, for the rest of
 * the day. Sending "end" first means the card disappears on its own.
 *
 * Options:
 *   ?end=no      delete without dismissing (leaves stale cards; rarely right)
 *   ?limit=N     how many devices to process in this call (default 40)
 *
 * WHY A LIMIT: every end push and every KV operation is a subrequest, and a
 * Worker invocation is capped at 50 of them on the free plan. So a big school
 * is purged a batch at a time — the response says how many are left, and you
 * just load the URL again until it reports none. The registry blob is only
 * cleared on the final batch, so /status stays honest in between.
 *
 * WHEN DEVICES COME BACK, which is the part that surprises people:
 *
 * The app skips a registration whose payload it has already sent (see
 * PushTokenService.registrationSignature) to stay inside the KV write quota,
 * and that signature lives on the DEVICE. Deleting the server's copy does not
 * clear it. So a purged device re-registers the next time its signature
 * changes, which is:
 *
 *   - the next calendar day (the date is part of the signature), or
 *   - a new app build, or a rotated push token — which is what stopping and
 *     restarting the Live Activity produces, making that the quickest way to
 *     bring one phone back the same day, or
 *   - Settings -> Delete All Data on that device, which drops the signature
 *     and the device ID outright.
 */
async function handlePurge(request, env, url) {
  if (url.searchParams.get("confirm") !== "yes") {
    return json({
      error: "Refusing to purge without confirmation.",
      howTo: "Add ?confirm=yes to this URL.",
      whatItDoes: "Dismisses the Live Activity on every registered phone, then deletes every registration.",
      whenDevicesReturn: "Next calendar day, or sooner on a new build, a restarted Live Activity, or Settings -> Delete All Data on the device.",
    }, 400);
  }

  if (!env.TOKENS) return json({ error: "KV binding 'TOKENS' is not configured." }, 500);

  const dismiss = url.searchParams.get("end") !== "no";
  const limit = Math.max(1, Number(url.searchParams.get("limit") ?? 40));

  const page = await env.TOKENS.list({ prefix: "token:" });
  const keys = page.keys.map(k => k.name);
  const batch = keys.slice(0, limit);

  // One token signs every push in this batch.
  let jwt = null, jwtError = null;
  if (dismiss && batch.length > 0) {
    try {
      jwt = await getAPNsJWT(env);
    } catch (e) {
      // Still purge: the operator asked for it, and a key problem is exactly
      // when you most want the stale registrations gone. Just say so plainly.
      jwtError = e.message;
      console.error(`[Purge] Could not build an APNs token, deleting without dismissing — ${e.message}`);
    }
  }

  let dismissed = 0, dismissFailed = 0, deleted = 0;
  for (const key of batch) {
    let record = null;
    try { record = await env.TOKENS.get(key, "json"); } catch { /* unreadable — delete it anyway */ }

    if (jwt && record && record.pushToken) {
      try {
        await sendAPNsEnd(
          record.pushToken,
          { slotStartMinutes: 0, isEnded: true },
          jwt, env, record.environment ?? "production"
        );
        dismissed++;
      } catch (e) {
        // A device that can't be reached still gets purged; its Live Activity
        // goes stale, which is strictly better than leaving it registered.
        dismissFailed++;
        console.log(`[Purge] End push failed for ${record.deviceId ?? key} — ${e.message}`);
      }
    }

    await env.TOKENS.delete(key);
    deleted++;
  }

  const remaining = keys.length - batch.length;
  const complete = remaining === 0 && page.list_complete;
  if (complete) await env.TOKENS.delete("registry:devices");

  console.log(`[Purge] Dismissed ${dismissed}, failed ${dismissFailed}, deleted ${deleted}, remaining ${remaining}`);
  return json({
    dismissed,
    dismissFailed,
    purged: deleted,
    remaining: page.list_complete ? remaining : `${remaining}+ (more pages)`,
    registryCleared: complete,
    ...(jwtError ? { warning: `Live Activities were NOT dismissed: ${jwtError}` } : {}),
    next: complete
      ? "Done. Every phone has been dismissed and unregistered."
      : "Load this URL again to continue with the next batch.",
    whenDevicesReturn: "Next calendar day, or sooner on a new build, a restarted Live Activity, or Settings -> Delete All Data on the device.",
  }, 200);
}

/** 480 -> "08:00". Minutes since local midnight, as a human reads a bell schedule. */
function clockTime(minutes) {
  if (minutes === null || minutes === undefined) return null;
  const h = Math.floor(minutes / 60), m = minutes % 60;
  return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Test push (legacy: v1.2 transition — remove after students update)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * GET /test-push[?deviceId=…][&minutes=…]
 *
 * Pushes to one device immediately and returns APNs's raw verdict per
 * endpoint. Defaults to the most recently registered device, and to that
 * device's first transition of the day, so a bare /test-push is useful.
 */
async function handleTestPush(request, env, url) {
  const devices = await readRegistry(env);
  if (devices.length === 0) {
    return json({ error: "No devices registered." }, 404);
  }

  const wanted = url.searchParams.get("deviceId");
  const device = wanted
    ? devices.find(d => d.deviceId === wanted)
    : [...devices].sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt)))[0];
  if (!device) return json({ error: `No device with id ${wanted}.` }, 404);

  const minutesParam = url.searchParams.get("minutes");
  const slotStartMinutes = minutesParam !== null
    ? Number(minutesParam)
    : (device.transitions ?? [480])[0];

  let jwt;
  try {
    jwt = await getAPNsJWT(env);
  } catch (e) {
    // A JWT that won't even build means the key itself is malformed — most
    // often a .p8 pasted with the BEGIN/END lines mangled or newlines eaten.
    return json({
      step: "building the APNs token",
      ok: false,
      error: e.message,
      hint: "Check APNS_PRIVATE_KEY (whole .p8 including BEGIN/END lines), APNS_KEY_ID, APNS_TEAM_ID.",
    }, 500);
  }

  const payload = {
    aps: {
      timestamp: Math.floor(Date.now() / 1000),
      event: "update",
      "content-state": { slotStartMinutes, isEnded: false },
      alert: {},
    },
  };

  // Try both endpoints regardless of what the device claims, so the answer
  // includes "it works, just on the other host".
  const attempts = [];
  for (const host of ["sandbox", "production"]) {
    attempts.push(await probeAPNs(device.pushToken, payload, jwt, env, host));
  }

  return json({
    deviceId: device.deviceId,
    registeredEnvironment: device.environment,
    appVersion: device.appVersion,
    topic: `${env.APNS_BUNDLE_ID}.push-type.liveactivity`,
    sentSlotStartMinutes: slotStartMinutes,
    attempts,
    verdict: attempts.some(a => a.ok)
      ? "APNs accepted the push. If the Lock Screen did not change, the problem is on the device, not here."
      : "APNs rejected every attempt — see reason above.",
  }, 200);
}

/** One APNs attempt that reports rather than acts. No device is ever removed. */
async function probeAPNs(pushToken, payload, jwt, env, environment) {
  const host = (environment === "sandbox") ? "api.sandbox.push.apple.com" : "api.push.apple.com";
  try {
    const resp = await fetch(`https://${host}/3/device/${pushToken}`, {
      method: "POST",
      headers: {
        "authorization":  `bearer ${jwt}`,
        "apns-topic":     `${env.APNS_BUNDLE_ID}.push-type.liveactivity`,
        "apns-push-type": "liveactivity",
        "apns-priority":  "10",
        "content-type":   "application/json",
      },
      body: JSON.stringify(payload),
    });
    const body = await resp.text();
    return {
      endpoint: environment,
      status: resp.status,
      ok: resp.ok,
      apnsId: resp.headers.get("apns-id"),
      response: body || "(empty — this is what success looks like)",
      meaning: explainAPNs(resp.status, body),
    };
  } catch (e) {
    return { endpoint: environment, status: null, ok: false, error: e.message };
  }
}

/** Plain-English translation of the APNs reasons this app actually hits. */
function explainAPNs(status, body) {
  if (status === 200) return "Accepted.";
  if (body.includes("BadEnvironmentKeyInToken")) {
    return "The .p8 key is restricted to the other environment. Generate a key valid for both Sandbox and Production, or test with a matching build.";
  }
  if (body.includes("InvalidProviderToken")) {
    return "APNs rejected the signing key: APNS_KEY_ID does not match APNS_PRIVATE_KEY, or the key belongs to a different team than APNS_TEAM_ID.";
  }
  if (body.includes("TopicDisallowed")) {
    return "APNS_BUNDLE_ID does not match an app this key can push to. It must be the app's bundle ID exactly.";
  }
  if (body.includes("DeviceTokenNotForTopic")) {
    return "This token was minted for a different bundle ID — usually a device still running the pre-migration build.";
  }
  if (body.includes("BadDeviceToken")) {
    return "Token not valid for this endpoint — right token, wrong sandbox/production host, or a stale token.";
  }
  if (body.includes("ExpiredProviderToken")) return "The signing token expired; the worker should mint a fresh one.";
  if (status === 410) return "The Live Activity already ended on that device.";
  return "Unrecognized APNs response — quote it verbatim when asking Apple.";
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Problem reports
//
// The app posts here when something is broken in a way the SCHOOL can fix:
// the calendar feed is down, a schedule was posted as a picture nobody can
// read, this Worker is full. /status then shows each problem once with a
// count of how many phones hit it, which is the only number that matters —
// three phones is a student's wifi, a hundred and eighty is an outage.
//
// WHY NOT EMAIL: one outage would send a mail per phone per retry. A page
// that is checked when something seems wrong beats an inbox nobody reads.
//
// STORAGE: one key per phone per problem per day,
//
//     issue:{day}:{kind}:{subject}:{deviceId}
//
// with everything worth showing in the KV metadata, so the whole page is
// rendered from ONE list() call and never reads the values. Keys expire after
// 7 days on their own — nothing has to sweep up. Phones report a given
// problem at most once a day (see IssueReporter in the app), so a school-wide
// outage costs about one KV write per phone, not one per retry.
// ─────────────────────────────────────────────────────────────────────────────

/** How long a reported problem stays visible on /status. */
const ISSUE_TTL_SECONDS = 7 * 24 * 60 * 60;

/** Keeps a value safe to paste into a KV key and short enough to stay cheap. */
function issueSafe(value, maxLength) {
  return String(value ?? "")
    .replace(/[^A-Za-z0-9._-]+/g, "-")
    .slice(0, maxLength);
}

async function handleReport(request, env) {
  let body;
  try { body = await request.json(); } catch {
    return new Response("Bad JSON", { status: 400 });
  }

  const { deviceId, kind, subject, detail, appVersion, osVersion } = body;
  if (!deviceId || !kind) {
    return new Response("Missing deviceId or kind", { status: 400 });
  }
  if (!env.TOKENS) {
    return new Response("KV binding 'TOKENS' is not configured.", { status: 500 });
  }

  const day = new Date().toISOString().slice(0, 10);
  const key = [
    "issue",
    day,
    issueSafe(kind, 40),
    issueSafe(subject, 40),
    issueSafe(deviceId, 40),
  ].join(":");

  // Empty value, everything in metadata: list() returns metadata, so /status
  // never has to read the records back one at a time. Metadata is capped at
  // 1 KB, hence the truncation.
  try {
    await env.TOKENS.put(key, "", {
      expirationTtl: ISSUE_TTL_SECONDS,
      metadata: {
        k: issueSafe(kind, 40),
        s: String(subject ?? "").slice(0, 40),
        d: String(detail ?? "").slice(0, 160),
        v: String(appVersion ?? "").slice(0, 20),
        o: String(osVersion ?? "").slice(0, 20),
        t: new Date().toISOString(),
      },
    });
  } catch (e) {
    console.error(`[Report] KV write failed: ${e.message}`);
    return new Response("Could not record report", { status: 500 });
  }

  console.log(`[Report] ${kind} ${subject ?? ""} from ${deviceId}: ${detail ?? ""}`);
  return json({ status: "recorded" }, 200);
}

/**
 * Every problem reported in the last week, grouped.
 *
 * One list() call. That matters: list() is capped at 1,000/day on the free
 * plan and the cron already spends ~720 reconciling the device registry, so
 * this stays a single call per page view rather than one per group.
 *
 * Without full, only TODAY is listed. A row on this page means "this
 * happened", not "this is happening", and a three-day-old row sitting next to
 * a live one reads like a fire that is still burning. The older rows are
 * still worth keeping — they answer "when did this start?" — so full brings
 * back the whole week, along with the individual reports behind each row
 * (device ID, app build, iOS version, message).
 */
async function readIssues(env, full) {
  if (!env.TOKENS) return { note: "KV binding 'TOKENS' is not configured.", groups: [] };

  let listing;
  try {
    listing = await env.TOKENS.list({ prefix: "issue:", limit: 1000 });
  } catch (e) {
    return { note: `Could not read issue reports: ${e.message}`, groups: [] };
  }

  const today = new Date().toISOString().slice(0, 10);
  const groups = new Map();

  for (const entry of listing.keys) {
    // issue:{day}:{kind}:{subject}:{deviceId}
    const parts = entry.name.split(":");
    if (parts.length < 5) continue;
    const [, day, kind, subject, deviceId] = parts;
    const meta = entry.metadata ?? {};
    const groupKey = `${day}|${kind}|${subject}`;

    let group = groups.get(groupKey);
    if (!group) {
      group = {
        day,
        kind,
        subject: meta.s || subject || null,
        deviceCount: 0,
        firstSeen: meta.t ?? null,
        lastSeen: meta.t ?? null,
        appVersions: new Set(),
        example: meta.d ?? null,
        reports: [],
      };
      groups.set(groupKey, group);
    }

    group.deviceCount += 1;
    if (meta.t) {
      if (!group.firstSeen || meta.t < group.firstSeen) group.firstSeen = meta.t;
      if (!group.lastSeen  || meta.t > group.lastSeen)  group.lastSeen  = meta.t;
    }
    if (meta.v) group.appVersions.add(meta.v);
    if (!group.example && meta.d) group.example = meta.d;
    if (full) {
      group.reports.push({
        deviceId,
        appVersion: meta.v ?? null,
        osVersion: meta.o ?? null,
        detail: meta.d ?? null,
        at: meta.t ?? null,
      });
    }
  }

  // Today first, then the biggest problems — which is the order someone
  // looking at this page actually cares about.
  const sorted = [...groups.values()].sort((a, b) =>
    (b.day.localeCompare(a.day)) || (b.deviceCount - a.deviceCount)
  );

  const todayGroups = sorted.filter(g => g.day === today);
  const shown = full ? sorted : todayGroups;
  const hidden = sorted.length - shown.length;

  return {
    // Named so the page answers "is anything wrong RIGHT NOW" before anyone
    // has to interpret a list.
    devicesReportingToday: todayGroups.reduce((n, g) => n + g.deviceCount, 0),
    groupsToday: todayGroups.length,
    // Says out loud that there is more to see, so nobody concludes from an
    // empty page that nothing has ever gone wrong.
    ...(hidden > 0
      ? { earlierDays: `${hidden} problem(s) from the past week — add ?full=1 to see them` }
      : {}),
    truncated: listing.list_complete === false,
    groups: shown.map(g => ({
      day: g.day,
      kind: g.kind,
      subject: g.subject,
      deviceCount: g.deviceCount,
      firstSeen: g.firstSeen,
      lastSeen: g.lastSeen,
      appVersions: [...g.appVersions],
      example: g.example,
      ...(full ? { reports: g.reports } : {}),
    })),
  };
}

function json(obj, status) {
  return new Response(JSON.stringify(obj, null, 2), {
    status,
    headers: { "content-type": "application/json; charset=utf-8" },
  });
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Cron
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Every minute: the broadcast, then the legacy per-phone pushes.
 *
 * Broadcast goes FIRST because it serves everyone on a current build for two
 * requests, and it must never be the thing that runs out of budget. Both
 * share one subrequest counter, so the legacy loop's own budget check sees
 * what the broadcast already spent and simply pushes fewer phones.
 */
async function runCron(rawEnv) {
  // Everything this run touches goes through a counted KV handle, so the
  // budget checks (broadcast's and legacy's) know what has already been
  // spent. Reset per run.
  const tally = { n: 0 };
  const env = { ...rawEnv, TOKENS: countingKV(rawEnv.TOKENS, tally), __tally: tally };

  const nowPT = nowInPT();
  const todayKey = formatDate(nowPT);
  const currentMinutes = nowPT.hours * 60 + nowPT.minutes;

  console.log(`[Cron] ${todayKey} ${String(nowPT.hours).padStart(2,'0')}:${String(nowPT.minutes).padStart(2,'0')} PT`);

  // Only skip weekends — the hours guard was removed when list() was replaced
  // by the registry key, eliminating the 1k/day list quota concern.
  if (nowPT.dow === 0 || nowPT.dow === 6) return;

  // Outside school hours there is nothing to push and nothing worth
  // reconciling, so don't spend quota.
  //
  // This matters more than it looks: the KV free tier resets at 00:00 UTC,
  // which is 5 PM PDT the PREVIOUS day. So by lunchtime local, 19 of the 24
  // quota-hours are already gone — most of them overnight with an empty
  // school. Running 24/7 spent ~570 list+write ops before first bell; a
  // 6 AM–5 PM window cuts that to ~330, and the content-comparison check in
  // reconcileRegistry drops the writes to roughly one per device per day.
  //
  // 6 AM is comfortably before the earliest registration (the Live Activity
  // starts within an hour of first bell); 5 PM is well after the last one.
  const hour = Math.floor(currentMinutes / 60);
  if (hour < 6 || hour >= 17) {
    return;
  }

  // A broadcast failure is logged and recorded, never allowed to stop the
  // legacy pushes that follow.
  try {
    await runBroadcastCycle(env, nowPT);
  } catch (e) {
    console.error(`[Broadcast] cycle failed — ${e.message}`);
  }

  await runLegacyPushCycle(env, currentMinutes);
}

/**
 * One push per registered phone at that phone's own bells.
 * v1.2 transition — remove after students update.
 */
async function runLegacyPushCycle(env, currentMinutes) {
  // Reconcile on even minutes only. list() is capped at 1,000/day: every
  // other minute is 720, every minute would be 1,440 and would start failing
  // partway through the afternoon. On reconcile minutes the returned list is
  // reused, so the blob is not read twice. The broadcast lists on the ODD
  // minutes, so inside the 6 AM–5 PM window the two cost 330 each.
  //
  // Keyed off currentMinutes (minutes since local midnight), which the
  // transition matching below also uses — one source of truth for "what time
  // is it" in this function.
  const devices = (currentMinutes % 2 === 0)
    ? await reconcileRegistry(env)
    : await readRegistry(env);

  if (devices.length === 0) {
    console.log("[Cron] No registered devices");
    return;
  }

  const jwt = await getAPNsJWT(env);   // crypto only — not a subrequest
  env.__jwt = jwt;

  // Sent in parallel chunks rather than one device at a time.
  //
  // Sequentially, a bell reached the last phone N × round-trip later: at 500
  // devices and ~60ms each that is half a minute of drift, and the next cron
  // fires at 60s. In chunks of 25 the same bell lands in about a second.
  //
  // This does NOT change how many devices fit on a plan. Subrequests are
  // counted per invocation, not per wave — 60 pushes is 60 subrequests
  // whether they go out one at a time or all at once — so the Free plan's
  // 50-per-invocation cap (KV operations included) still bites at roughly 45
  // devices. Chunking buys latency, nothing else. The cap is why the chunk
  // size is modest: a wave that overruns the limit fails unpredictably within
  // that wave, and smaller waves keep the damage legible in the logs.
  const CHUNK_SIZE = 25;
  const budget = subrequestBudget(env);
  let pushed = 0;
  let stoppedShort = false;

  for (let i = 0; i < devices.length; i += CHUNK_SIZE) {
    // Stop BEFORE the platform stops us.
    //
    // Cloudflare throws once an invocation exceeds its subrequest allowance
    // (50 on Free, KV operations included). The catch is that after that
    // throw every further subrequest fails too — including the KV write that
    // would record what just happened. So the ceiling cannot be discovered by
    // running into it; it has to be respected in advance.
    //
    // RESERVE leaves room for the bookkeeping write below, so the run always
    // has enough budget left to say what it could not do.
    const remaining = budget - spent(env) - CAPACITY_WRITE_RESERVE;
    if (remaining <= 0) { stoppedShort = true; break; }

    const chunk = devices.slice(i, i + Math.min(CHUNK_SIZE, remaining));
    await Promise.all(chunk.map(device => pushToDevice(device, currentMinutes, env)));
    pushed += chunk.length;
    if (chunk.length < CHUNK_SIZE && i + chunk.length < devices.length) { stoppedShort = true; break; }
  }

  if (stoppedShort) {
    console.error(
      `[Cron] SUBREQUEST CEILING — pushed ${pushed} of ${devices.length}; ` +
      `the rest get no bell this minute. Recording capacity.`
    );
    await recordCapacityWall(env, pushed);
  } else {
    await recordCapacityProven(env, pushed);
  }
}

/**
 * How many subrequests this invocation has spent so far.
 *
 * Every KV read, write, delete, list and every APNs push counts against the
 * same allowance, so they are all tallied through one counter that
 * runCron() resets at the start of each run.
 */
function spent(env) { return env.__tally ? env.__tally.n : 0; }

/** Wraps a KV namespace so every operation is counted. */
function countingKV(tokens, tally) {
  return {
    get:    (...a) => { tally.n++; return tokens.get(...a); },
    put:    (...a) => { tally.n++; return tokens.put(...a); },
    delete: (...a) => { tally.n++; return tokens.delete(...a); },
    list:   (...a) => { tally.n++; return tokens.list(...a); },
  };
}

/** Remember the ceiling this run had to stop at, and the budget it was under. */
async function recordCapacityWall(env, pushed) {
  const observed = await readCapacity(env);
  const budget = subrequestBudget(env);
  const sameBudget = (observed.wallBudget ?? DEFAULT_SUBREQUEST_BUDGET) === budget;
  // Under the same budget keep the LOWEST ceiling seen — that is what actually
  // fits. Under a new budget the old wall is meaningless, so start over.
  const wall = observed.wall && sameBudget ? Math.min(observed.wall, pushed) : pushed;
  await env.TOKENS.put(CAPACITY_KEY, JSON.stringify({
    proven: observed.proven, wall, wallAt: new Date().toISOString(), wallBudget: budget,
  }));
}

/**
 * Remember a bell that went out in full. Only written when the number grows,
 * so this costs one KV write on the day the school adds its biggest cohort
 * and nothing on any other day. Reported on /status as evidence of what has
 * actually worked; the limit itself comes from the budget (effectiveLimit).
 */
async function recordCapacityProven(env, pushed) {
  if (pushed === 0) return;
  const observed = await readCapacity(env);
  if (pushed <= observed.proven) return;
  await env.TOKENS.put(CAPACITY_KEY, JSON.stringify({ ...observed, proven: pushed }));
  console.log(`[Capacity] ${pushed} pushes completed cleanly — new proven capacity`);
}

/**
 * Everything one device needs this minute: the transition push, and the
 * end-of-day dismissal. Each device is independent, which is what makes the
 * chunked parallelism above safe — no two of these touch the same KV key.
 */
async function pushToDevice(device, currentMinutes, env) {
  const jwt = env.__jwt;
  const transitions = device.transitions ?? [];
  const endMinutes  = device.endMinutes  ?? null;

  if (transitions.length === 0) {
    console.log(`[Cron] ${device.deviceId} — no transitions stored, skipping`);
    return;
  }

  // Find a transition that just fired (within the last 2 minutes)
  const firedMinutes = transitions.find(t => {
    const diff = currentMinutes - t;
    return diff >= 0 && diff < 2;
  });

  if (firedMinutes !== undefined) {
    const isLast = firedMinutes === transitions[transitions.length - 1];
    console.log(`[Cron] ${device.deviceId} → transition at ${firedMinutes}min${isLast ? " (last)" : ""}`);

    const { dead, environment: workingEnv } = await sendAPNsUpdate(device.pushToken,
      { slotStartMinutes: firedMinutes, isEnded: false },
      jwt, env, device.environment).catch(err => { console.log(`[APNs] ✗ ${device.deviceId}: ${err.message}`); return { dead: false }; });

    if (dead) {
      console.log(`[APNs] 💀 ${device.deviceId} — dead token, removing`);
      await removeDevice(device.deviceId, env);
      return;
    }

    // The retry found the other endpoint — persist it so subsequent pushes
    // go straight there instead of paying the failed attempt every time.
    if (workingEnv && workingEnv !== device.environment) {
      await updateDeviceEnvironment(device.deviceId, workingEnv, env);
    }
  }

  // End-of-day dismissal.
  //
  // Fired directly off endMinutes rather than via an endpush:{id}:{date}
  // key. That key cost one KV READ per device per minute (half the read
  // budget) and one WRITE per device per day, purely to remember something
  // already present in the record. The same 2-minute window used for
  // transitions applies; a duplicate "end" event is harmless because iOS
  // has already dismissed the activity and the second push is a no-op.
  if (endMinutes !== null && endMinutes > 0) {
    const endDiff = currentMinutes - endMinutes;
    if (endDiff >= 0 && endDiff < 2) {
      console.log(`[Cron] ${device.deviceId} — sending end push (${endMinutes}min)`);
      const { dead } = await sendAPNsEnd(device.pushToken,
        { slotStartMinutes: 0, isEnded: true },
        jwt, env, device.environment).catch(err => { console.log(`[APNs] ✗ ${device.deviceId}: ${err.message}`); return { dead: false }; });
      if (dead) await removeDevice(device.deviceId, env);
    }
  }
}



/**
 * Sends a Live Activity update push (event: "update").
 * Returns { dead: true } if the token is no longer valid.
 * Throws on unexpected errors.
 */
async function sendAPNsUpdate(pushToken, contentState, jwt, env, environment = "production") {
  const payload = {
    aps: {
      timestamp: Math.floor(Date.now() / 1000),
      event: "update",
      "content-state": contentState,
      alert: {},
    },
  };
  return sendAPNsPayload(pushToken, payload, jwt, env, environment);
}

/**
 * Sends a Live Activity end push (event: "end").
 * iOS immediately dismisses the Live Activity on all surfaces.
 * Returns { dead: true } if the token is no longer valid.
 * Throws on unexpected errors.
 */
async function sendAPNsEnd(pushToken, contentState, jwt, env, environment = "production") {
  const payload = {
    aps: {
      timestamp: Math.floor(Date.now() / 1000),
      event: "end",
      "content-state": contentState,
      "dismissal-date": Math.floor(Date.now() / 1000), // dismiss immediately
      alert: {},
    },
  };
  return sendAPNsPayload(pushToken, payload, jwt, env, environment);
}

/**
 * Shared APNs HTTP/2 request.
 * Returns { dead: bool, environment: string } — environment is the one that
 * actually worked, which may differ from the one passed in.
 * Throws on non-dead errors.
 *
 * Environment fallback: a token is only valid against the endpoint matching
 * the aps-environment entitlement it was minted under, and clients have
 * historically mis-reported that (the app derived it from #if DEBUG rather
 * than from the entitlement, so a Release-from-Xcode build claimed
 * "production" while holding a sandbox token). Rather than trust the claim,
 * a BadDeviceToken is retried once against the other host before the token is
 * declared dead. Without this, one mis-labeled registration silently removed
 * the device from the registry for the rest of the day.
 */
async function sendAPNsPayload(pushToken, payload, jwt, env, environment = "production") {
  const primary  = (environment === "sandbox") ? "sandbox" : "production";
  const fallback = (primary === "sandbox") ? "production" : "sandbox";

  let result = await sendToHost(pushToken, payload, jwt, env, primary);

  // Only a token/topic mismatch is worth retrying — 410 Gone means the
  // activity genuinely ended on the device, and that's final.
  if (result.badToken) {
    console.log(`[APNs] retrying on ${fallback} after BadDeviceToken on ${primary}`);
    result = await sendToHost(pushToken, payload, jwt, env, fallback);
    if (!result.dead && !result.badToken) {
      return { dead: false, environment: fallback };
    }
  }

  return { dead: result.dead || result.badToken, environment: primary };
}

/** Single APNs attempt against one host. Returns { dead, badToken }. */
async function sendToHost(pushToken, payload, jwt, env, environment) {
  if (env.__tally) env.__tally.n++;   // an APNs push is a subrequest like any other
  const bundleId = env.APNS_BUNDLE_ID;
  const host = (environment === "sandbox")
    ? "api.sandbox.push.apple.com"
    : "api.push.apple.com";
  const url = `https://${host}/3/device/${pushToken}`;

  const resp = await fetch(url, {
    method: "POST",
    headers: {
      "authorization":  `bearer ${jwt}`,
      "apns-topic":     `${bundleId}.push-type.liveactivity`,
      "apns-push-type": "liveactivity",
      "apns-priority":  "10",
      "content-type":   "application/json",
    },
    body: JSON.stringify(payload),
  });

  // 410 Gone — activity ended on device; token permanently dead. Never retried.
  if (resp.status === 410) {
    console.log(`[APNs] 410 Gone on ${environment} — activity ended on device`);
    return { dead: true, badToken: false };
  }

  if (resp.status === 403) {
    // Auth-class failure: the JWT is being rejected, not the token. Most
    // often an environment-restricted .p8 (BadEnvironmentKeyInToken) or a
    // Key ID that doesn't match the key file (InvalidProviderToken).
    // Logged loudly and NOT swallowed as a dead token — killing the device
    // registration over a server-side key problem is exactly backwards.
    const body = await resp.text();
    console.error(`[APNs] ⚠ 403 AUTH FAILURE on ${environment} — ${body}`);
    console.error(`[APNs]   → check the .p8 key's environment + Key ID in Worker vars`);
    return { dead: false, badToken: false };
  }

  if (resp.status === 400) {
    const body = await resp.text();
    if (body.includes("BadDeviceToken") || body.includes("DeviceTokenNotForTopic")) {
      console.log(`[APNs] 400 bad token on ${environment} — ${body}`);
      return { dead: false, badToken: true };
    }
    throw new Error(`APNs 400 (${environment}): ${body}`);
  }

  if (!resp.ok) {
    const body = await resp.text();
    throw new Error(`APNs ${resp.status} (${environment}): ${body}`);
  }

  // Success is logged explicitly. Without this, "APNs accepted the push" and
  // "we never got as far as sending" produce identical log output — silence —
  // which is exactly the ambiguity that made the 403 take days to find.
  // apns-id is Apple's own request identifier: quoting it in a support ticket
  // or matching it against a device log is the only way to trace one push.
  console.log(`[APNs] ✓ 200 on ${environment} — apns-id: ${resp.headers.get("apns-id") || "none"}`);
  return { dead: false, badToken: false };
}

/** Persists a corrected environment so the next push skips the retry. */
async function updateDeviceEnvironment(deviceId, environment, env) {
  try {
    // Write through the device's own key. The blob picks it up on the next
    // reconcile via the metadata stamp — same path as a registration, so
    // there's only ever one writer per key.
    const value = await env.TOKENS.get(`token:${deviceId}`, "json");
    if (!value || value.environment === environment) return;
    value.environment = environment;
    value.updatedAt = new Date().toISOString();
    await env.TOKENS.put(`token:${deviceId}`, JSON.stringify(value), {
      metadata: { u: value.updatedAt },
    });
    console.log(`[Registry] ${deviceId} environment corrected → ${environment}`);
  } catch (e) {
    console.error(`[Registry] Failed to update environment for ${deviceId}: ${e.message}`);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - APNs JWT
// ─────────────────────────────────────────────────────────────────────────────

// Cache JWT in memory for up to 45 minutes (Apple requires refresh < 60 min)
let jwtCache = { token: null, generatedAt: 0 };

async function getAPNsJWT(env) {
  // Fail loudly and specifically on missing config.
  //
  // Without this, an unset secret surfaces as
  // "TypeError: Cannot read properties of undefined (reading 'replace')"
  // from deep inside generateJWT — which says nothing about WHICH variable is
  // missing, and buried the real cause for days. The push cycle then throws
  // before sending anything, so there are no [APNs] lines at all and the
  // failure looks like silence rather than an error.
  const required = ["APNS_PRIVATE_KEY", "APNS_KEY_ID", "APNS_TEAM_ID", "APNS_BUNDLE_ID"];
  const missing = required.filter(k => !env[k]);
  if (missing.length) {
    throw new Error(
      `APNs config missing: ${missing.join(", ")} \u2014 set these in the Worker's ` +
      `Settings \u2192 Variables and Secrets, then redeploy.`
    );
  }
  const now = Math.floor(Date.now() / 1000);
  if (jwtCache.token && now - jwtCache.generatedAt < 45 * 60) {
    return jwtCache.token;
  }

  const token = await generateJWT(env.APNS_KEY_ID, env.APNS_TEAM_ID, env.APNS_PRIVATE_KEY);
  jwtCache = { token, generatedAt: now };
  return token;
}

async function generateJWT(keyId, teamId, privateKeyPem) {
  const pemBody = privateKeyPem
    .replace(/-----BEGIN PRIVATE KEY-----/, "")
    .replace(/-----END PRIVATE KEY-----/, "")
    .replace(/-----BEGIN EC PRIVATE KEY-----/, "")
    .replace(/-----END EC PRIVATE KEY-----/, "")
    .replace(/\s+/g, "");

  const keyData = Uint8Array.from(atob(pemBody), c => c.charCodeAt(0));

  const cryptoKey = await crypto.subtle.importKey(
    "pkcs8",
    keyData.buffer,
    { name: "ECDSA", namedCurve: "P-256" },
    false,
    ["sign"]
  );

  const header  = { alg: "ES256", kid: keyId };
  const payload = { iss: teamId, iat: Math.floor(Date.now() / 1000) };

  const encode = obj => btoa(JSON.stringify(obj))
    .replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");

  const signingInput = `${encode(header)}.${encode(payload)}`;
  const signingBytes = new TextEncoder().encode(signingInput);

  const sigBuffer = await crypto.subtle.sign(
    { name: "ECDSA", hash: "SHA-256" },
    cryptoKey,
    signingBytes
  );

  const sig = btoa(String.fromCharCode(...new Uint8Array(sigBuffer)))
    .replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");

  return `${signingInput}.${sig}`;
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Legacy registry (v1.2 transition — remove after students update)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Reads every device record in ONE KV read.
 *
 * WHY ONE BLOB, AND WHY ONLY THE CRON WRITES IT — two separate problems:
 *
 * 1. READS. The push cycle used to read token:{deviceId} for every device
 *    every minute: 1 + 2N reads × 1,440 minutes against a 100,000/day
 *    free-tier cap put the ceiling at ~34 devices, and KV caps are hard
 *    failures rather than throttling. One blob makes the cycle 1,440
 *    reads/day regardless of how many phones there are.
 *
 * 2. WRITES RACING. If each registration read-modify-wrote the shared blob,
 *    records would be lost: KV is eventually consistent, reads are edge-cached
 *    for up to 60s, and concurrent writes to one key silently overwrite each
 *    other. With a few hundred handsets registering across a morning that is
 *    routine data loss. So devices write only their OWN key, and the cron — a
 *    single process — owns the blob, reconciling every 2 minutes via list()
 *    (capped at 1,000/day: 720 fits, 1,440 would not). The cost is that a new
 *    device waits up to two minutes to be picked up.
 *
 * Handles the legacy format transparently: registry:devices used to be an
 * array of deviceId STRINGS, with the records themselves in token:{id}. If
 * that shape is found it is migrated in place — N reads and one write, once —
 * so an in-flight school day keeps working across the deploy without anyone
 * re-registering.
 */
async function readRegistry(env) {
  const raw = await env.TOKENS.get("registry:devices");
  if (!raw) return [];

  let parsed;
  try { parsed = JSON.parse(raw); } catch { return []; }
  if (!Array.isArray(parsed) || parsed.length === 0) return [];

  // New format: array of record objects.
  if (typeof parsed[0] === "object" && parsed[0] !== null) {
    return parsed.filter(d => d && d.deviceId && d.pushToken);
  }

  // Legacy format: array of deviceId strings — hydrate and migrate.
  console.log(`[Registry] Legacy format detected — migrating ${parsed.length} device(s)`);
  const records = [];
  for (const deviceId of parsed) {
    const value = await env.TOKENS.get(`token:${deviceId}`, "json");
    if (value?.pushToken) {
      records.push({
        deviceId,
        pushToken:   value.pushToken,
        environment: value.environment ?? "production",
        transitions: value.transitions ?? null,
        endMinutes:  value.endMinutes  ?? null,
        appVersion:  value.appVersion  ?? null,
        osVersion:   value.osVersion   ?? null,
        updatedAt:   value.updatedAt   ?? new Date().toISOString(),
      });
    }
  }
  await env.TOKENS.put("registry:devices", JSON.stringify(records));
  console.log(`[Registry] Migration complete — ${records.length} device(s) carried over`);
  return records;
}

/** Replaces the whole registry blob. Cron-only — see the header note. */
async function writeRegistry(devices, env) {
  await env.TOKENS.put("registry:devices", JSON.stringify(devices));
}

/**
 * Reconciles registry:devices against the token:{id} keys.
 *
 * The cron is the ONLY writer of the blob, which is what makes this race-free
 * — there is exactly one scheduled invocation per minute, so no two processes
 * modify the key concurrently.
 *
 * list() returns each key's metadata, so a device whose record changed is
 * detected by comparing the metadata stamp against the blob — no read needed
 * for unchanged devices. Only new or updated records cost a get().
 *
 * Returns the reconciled device list so the caller doesn't read it again.
 */
async function reconcileRegistry(env) {
  const existing = await readRegistry(env);
  const byId = new Map(existing.map(d => [d.deviceId, d]));

  const next = [];
  let hydrated = 0;
  let cursor;

  do {
    const page = await env.TOKENS.list({ prefix: "token:", cursor });
    for (const key of page.keys) {
      const deviceId = key.name.slice("token:".length);
      const stamp = key.metadata?.u ?? null;
      const current = byId.get(deviceId);

      // Unchanged and already known — carry it over, no read.
      if (current && stamp && current.updatedAt === stamp) {
        next.push(current);
        continue;
      }

      // No stamp means a record written before metadata was introduced. Read
      // it, and re-put it WITH a stamp so this pass is the last one that has
      // to. Costs one write once per stale record, rather than a read every
      // two minutes indefinitely.
      const value = await env.TOKENS.get(key.name, "json");
      hydrated++;
      if (value?.pushToken) {
        const record = {
          deviceId,
          pushToken:   value.pushToken,
          environment: value.environment ?? "production",
          transitions: value.transitions ?? null,
          endMinutes:  value.endMinutes  ?? null,
          appVersion:  value.appVersion  ?? null,
          osVersion:   value.osVersion   ?? null,
          updatedAt:   value.updatedAt   ?? new Date().toISOString(),
        };
        if (!stamp) {
          await env.TOKENS.put(key.name, JSON.stringify(record), {
            metadata: { u: record.updatedAt },
          });
          console.log(`[Registry] Backfilled metadata stamp for ${deviceId}`);
        }
        next.push(record);
      }
    }
    cursor = page.list_complete ? null : page.cursor;
  } while (cursor);

  // Write only when the CONTENT actually changed.
  //
  // Previously this triggered on `hydrated > 0`, which conflated "had to
  // read a record" with "the record is different." A token: key written
  // before metadata stamps existed has no stamp, so it gets re-hydrated on
  // every single pass — and the old condition then rewrote the blob every
  // two minutes, forever, with byte-identical content. Three devices were
  // enough to burn a third of the daily write quota by noon.
  //
  // Comparing the serialized form is exact and cheap: list() returns keys in
  // a stable order, so an unchanged registry serializes identically.
  const nextJson = JSON.stringify(next);
  if (nextJson !== JSON.stringify(existing)) {
    await env.TOKENS.put("registry:devices", nextJson);
    console.log(`[Registry] Reconciled — ${next.length} device(s), ${hydrated} hydrated, blob updated`);
  } else if (hydrated > 0) {
    // Reads happened but nothing moved — worth seeing, because it means
    // records are missing their metadata stamps and every pass is paying
    // for reads it shouldn't need.
    console.log(`[Registry] Reconciled — ${hydrated} record(s) re-read but unchanged (missing metadata stamp?)`);
  }

  return next;
}

/**
 * Rebuilds registry:devices from the token:{id} keys, ignoring the existing
 * blob entirely. Manual recovery via GET /rebuild.
 */
async function rebuildRegistry(env) {
  await env.TOKENS.put("registry:devices", JSON.stringify([]));
  const devices = await reconcileRegistry(env);
  console.log(`[Registry] Rebuilt — ${devices.length} device(s)`);
  return devices.length;
}

// Deletes a device's token. The blob catches up on the next reconcile.
async function removeDevice(deviceId, env) {
  await env.TOKENS.delete(`token:${deviceId}`);
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Time utilities (Pacific Time)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Returns the current time broken into components in Pacific Time.
 *
 * BUG FIXED: The original implementation used:
 *   new Date(year, month - 1, day, hour, minute, second)
 * which calls the Date constructor with LOCAL time components — but Cloudflare
 * Workers run in UTC, so those components were treated as UTC, producing a Date
 * that was (UTC offset) hours wrong. On a PDT day (-7h), 8:00 AM PT was
 * computed as 8:00 AM UTC = 1:00 AM PT. All period-transition comparisons
 * were firing against the wrong minutes, causing missed or wrong-time pushes.
 *
 * Fix: derive everything from the raw UTC epoch using Intl.DateTimeFormat,
 * then work purely with the extracted numeric values. We never construct a
 * Date from local parts — only the epoch-safe new Date() is used.
 *
 * Returns: { year, month, day, hours, minutes, seconds, dow, iso }
 *   dow — 0=Sunday … 6=Saturday (matches JS getDay() convention)
 *   iso — "YYYY-MM-DD" in Pacific time (for KV keys / schedule lookup)
 */
function nowInPT() {
  const now = new Date(); // UTC epoch — safe everywhere

  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: "America/Los_Angeles",
    year:    "numeric",
    month:   "2-digit",
    day:     "2-digit",
    hour:    "2-digit",
    minute:  "2-digit",
    second:  "2-digit",
    hour12:  false,
    weekday: "short",
  }).formatToParts(now);

  const get = (type) => parts.find(p => p.type === type)?.value ?? "0";

  const year    = parseInt(get("year"));
  const month   = parseInt(get("month"));
  const day     = parseInt(get("day"));
  // hour12:false can return "24" at midnight — normalize to 0
  const hours   = parseInt(get("hour")) % 24;
  const minutes = parseInt(get("minute"));
  const seconds = parseInt(get("second"));

  // Derive day-of-week (0=Sun…6=Sat) from the 3-letter weekday abbreviation.
  const weekdayStr = get("weekday").toLowerCase().slice(0, 3);
  const dowMap = { sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6 };
  const dow = dowMap[weekdayStr] ?? 0;

  const iso = `${year}-${String(month).padStart(2,"0")}-${String(day).padStart(2,"0")}`;

  return { year, month, day, hours, minutes, seconds, dow, iso };
}

/**
 * Returns "YYYY-MM-DD" from a PT time struct returned by nowInPT().
 * Kept as a separate function to mirror the original call sites.
 */
function formatDate(ptTime) {
  return ptTime.iso;
}
