:root{--bg:#f2f3f7;--card:#fff;--text:#0a0c10;--muted:#5b6472;--line:#e3e6ec;--soft:#f2f3f7;--accent:#2f5fc4;--on-accent:#fff;--gold:#a8790a;--ok:#2f5fc4;--bad:#d64545;--warn:#c9691f;--idle:#9aa1af;--c3:#6425c4;--c4:#0e8c7a;--c5:#b8368a;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0a0c10;--card:#13161c;--text:#fff;--muted:#8a93a8;--line:#262b36;--soft:#1c2029;--accent:#3a6fd8;--on-accent:#fff;--gold:#f5b800;--ok:#3a6fd8;--bad:#ff6b6b;--warn:#fb923c;--idle:#646c82;--c3:#7c3aed;--c4:#2dd4bf;--c5:#f472b6;color-scheme:dark}}
